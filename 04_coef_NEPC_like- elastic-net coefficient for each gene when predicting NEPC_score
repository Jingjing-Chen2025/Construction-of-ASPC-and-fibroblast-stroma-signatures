msg("Stable for BOTH targets        : %d genes",
    sum(stability_tbl$stability_selected_both, na.rm = TRUE))

# ============================================================================
# STEP 8 — WRITE OUTPUTS
# ============================================================================
hdr("STEP 8 — outputs")

readr::write_csv(multi_task_tbl, out_multi_task_csv)
readr::write_csv(stability_tbl,  out_stability_csv)

diag_tbl <- tibble(
  target      = c("NEPC_score", "ASPC_fraction"),
  alpha       = c(fit_nepc$alpha, fit_aspc$alpha),
  lambda      = c(fit_nepc$lambda, fit_aspc$lambda),
  lambda_rule = cfg$lambda_rule,
  cv_error    = c(fit_nepc$err, fit_aspc$err),
  n_nonzero   = c(fit_nepc$n_nonzero, fit_aspc$n_nonzero),
  n_features  = ncol(X),
  n_samples   = nrow(X),
  feature_source = feat_tbl$source[1],
  tau_threshold  = cfg$tau_threshold,
  ratio_threshold = cfg$ratio_threshold
)
readr::write_csv(diag_tbl, out_diag_csv)

msg("Wrote: %s  (%d rows)", out_multi_task_csv, nrow(multi_task_tbl))
msg("Wrote: %s  (%d rows)", out_stability_csv,  nrow(stability_tbl))
msg("Wrote: %s", out_diag_csv)

cat("\n--- Model summary ---\n")
print(as.data.frame(diag_tbl))

