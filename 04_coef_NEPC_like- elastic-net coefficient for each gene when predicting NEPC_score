# ============================================================================
hdr("STEP 6 — elastic net")

fit_tuned <- function(y_vec, X, label) {
  ok <- is.finite(y_vec) & apply(X, 1, function(r) all(is.finite(r)))
  X2 <- X[ok, , drop = FALSE]; y2 <- as.numeric(y_vec[ok])
  msg("  %s: %d usable samples", label, length(y2))
  nf <- min(cfg$nfolds, length(y2))
  if (nf < 3) stop("Too few samples for CV in ", label)

  best <- NULL
  for (a in cfg$alpha_grid) {
    cv <- tryCatch(glmnet::cv.glmnet(X2, y2, alpha = a, standardize = TRUE, nfolds = nf),
                   error = function(e) {
                     warn_msg("    alpha=%.1f failed: %s", a, conditionMessage(e)); NULL })
    if (is.null(cv)) next
    err <- min(cv$cvm)
    msg("    alpha=%.1f  cv err=%.4f  lambda.min=%.5f  nonzero=%d",
        a, err, cv$lambda.min, cv$nzero[which.min(cv$cvm)])
    if (is.null(best) || err < best$err) best <- list(cv = cv, alpha = a, err = err)
  }
  if (is.null(best)) stop("All alpha values failed for ", label)

  msg("  %s: selected alpha=%.1f", label, best$alpha)
  b <- as.matrix(coef(best$cv, s = cfg$lambda_rule))
  nz <- sum(abs(b[-1, 1]) > cfg$coef_eps)

  # null-model reference: how much better than predicting the mean?
  null_err <- stats::var(y2)
  msg("  %s: CV err %.4f vs null (variance) %.4f -> R2_cv %.3f",
      label, best$err, null_err, 1 - best$err / null_err)
  if (best$err >= null_err) {
    warn_msg("  %s: CV error is NOT better than the null model. The fitted", label)
    warn_msg("  coefficients carry no predictive information.")
  }
  if (nz == 0) warn_msg("  %s selected NO genes.", label)

  list(coef = b, alpha = best$alpha, cv = best$cv,
       lambda = best$cv[[cfg$lambda_rule]], err = best$err,
       r2_cv = 1 - best$err / null_err, n_nonzero = nz)
}

msg("Fitting NEPC_score ...")
fit_nepc <- fit_tuned(NEPC_score, X, "NEPC_score")
msg("Fitting ASPC_fraction ...")
fit_aspc <- fit_tuned(ASPC_fraction, X, "ASPC_fraction")

msg("Non-zero coefficients: NEPC %d, ASPC %d", fit_nepc$n_nonzero, fit_aspc$n_nonzero)

extract_coef <- function(b) b[setdiff(rownames(b), "(Intercept)"), 1]
cN <- extract_coef(fit_nepc$coef)
cA <- extract_coef(fit_aspc$coef)

all_genes <- sort(unique(c(names(cN), names(cA))))
cN <- cN[all_genes]; cN[is.na(cN)] <- 0
cA <- cA[all_genes]; cA[is.na(cA)] <- 0

multi_task_tbl <- tibble::tibble(
  gene = all_genes,
  coef_NEPC_like = as.numeric(cN),
  coef_ASPC_fraction = as.numeric(cA)
) %>%
  dplyr::mutate(
    multi_task_positive = (coef_NEPC_like > 0) & (coef_ASPC_fraction > 0),
    multi_task_nonzero  = (abs(coef_NEPC_like) > cfg$coef_eps) &
                          (abs(coef_ASPC_fraction) > cfg$coef_eps),
    coef_product = coef_NEPC_like * coef_ASPC_fraction
  ) %>%
  dplyr::arrange(dplyr::desc(multi_task_positive), dplyr::desc(coef_product))

