read_if_exists <- function(path, label) {
  if (!file.exists(path)) { warn_msg("  %s not found: %s", label, basename(path)); return(NULL) }
  msg("  Reading %s: %s", label, basename(path))
  suppressMessages(readr::read_csv(path, show_col_types = FALSE))
}

# 03_ v6 renamed the ratio column; accept either
RATIO_CANDIDATES <- c("target_specific_ratio", "aspc_specific_ratio",
                      "ratio_max", "ratio_mean")

build_feature_universe <- function(group_name, root) {
  tau_tbl   <- read_if_exists(file.path(root, sprintf("tau_%s_all_datasets.csv", group_name)),
                              "02_ tau table")
  ratio_tbl <- read_if_exists(file.path(root, sprintf("ratio_%s_all_datasets.csv", group_name)),
                              "03_ ratio table")
  recur_tbl <- read_if_exists(file.path(root, sprintf("target_markers_%s_recurrence.csv", group_name)),
                              "03_ marker recurrence")
  parts <- list()

  if (!is.null(tau_tbl) && all(c("gene","tau") %in% names(tau_tbl))) {
    hit <- tau_tbl %>%
      dplyr::filter(is.finite(tau), tau >= cfg$tau_threshold) %>%
      dplyr::transmute(gene = toupper(gene), tau = tau)
    msg("  tau >= %.2f : %d genes", cfg$tau_threshold, nrow(hit))
    parts$tau <- hit
  }

  if (!is.null(ratio_tbl) && "gene" %in% names(ratio_tbl)) {
    rcol <- intersect(RATIO_CANDIDATES, names(ratio_tbl))[1]
    if (!is.na(rcol)) {
      msg("  ratio column in use: %s", rcol)
      hit <- ratio_tbl %>%
        dplyr::filter(is.finite(.data[[rcol]]), .data[[rcol]] >= cfg$ratio_threshold) %>%
        dplyr::transmute(gene = toupper(gene), ratio = .data[[rcol]])
      msg("  %s >= %.1f : %d genes", rcol, cfg$ratio_threshold, nrow(hit))
      parts$ratio <- hit
    } else warn_msg("  No recognised ratio column in %s", group_name)
  }

  if (!is.null(recur_tbl) && all(c("gene","n_datasets") %in% names(recur_tbl))) {
    n_coh <- max(recur_tbl$n_datasets, na.rm = TRUE)
    for (k in seq_len(n_coh)) {
      msg("    recurrence >= %d of %d : %d genes", k, n_coh,
          sum(recur_tbl$n_datasets >= k, na.rm = TRUE))
    }
    hit <- recur_tbl %>%
      dplyr::filter(n_datasets >= cfg$min_marker_cohorts) %>%
      dplyr::transmute(gene = toupper(gene), n_marker_cohorts = n_datasets)
    msg("  marker in >= %d cohorts : %d genes", cfg$min_marker_cohorts, nrow(hit))
    parts$marker <- hit
  }

  if (!length(parts)) return(NULL)

  Reduce(function(a, b) dplyr::full_join(a, b, by = "gene"), parts) %>%
    dplyr::mutate(
      via_tau    = if ("tau" %in% names(.)) !is.na(tau) else FALSE,
      via_ratio  = if ("ratio" %in% names(.)) !is.na(ratio) else FALSE,
      via_marker = if ("n_marker_cohorts" %in% names(.)) !is.na(n_marker_cohorts) else FALSE
    )
}

