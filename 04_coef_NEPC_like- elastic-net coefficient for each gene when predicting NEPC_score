read_if_exists <- function(path, label) {
  if (!file.exists(path)) {
    warn_msg("  %s not found: %s", label, path)
    return(NULL)
  }
  msg("  Reading %s: %s", label, basename(path))
  readr::read_csv(path, show_col_types = FALSE)
}

build_feature_universe <- function(group_name, root) {
  tau_tbl   <- read_if_exists(file.path(root, sprintf("tau_%s_all_datasets.csv", group_name)),
                              "02_ tau table")
  ratio_tbl <- read_if_exists(file.path(root, sprintf("ratio_%s_all_datasets.csv", group_name)),
                              "03_ ratio table")
  recur_tbl <- read_if_exists(file.path(root, sprintf("target_markers_%s_recurrence.csv", group_name)),
                              "03_ marker recurrence")

  parts <- list()

  if (!is.null(tau_tbl) && all(c("gene", "tau") %in% names(tau_tbl))) {
    hit <- tau_tbl %>%
      filter(is.finite(tau), tau >= cfg$tau_threshold) %>%
      transmute(gene = toupper(gene), tau = tau)
    msg("  tau >= %.2f : %d genes", cfg$tau_threshold, nrow(hit))
    parts$tau <- hit
  }

  if (!is.null(ratio_tbl) && "gene" %in% names(ratio_tbl)) {
    rcol <- intersect(c("aspc_specific_ratio", "ratio_max", "ratio_mean"), names(ratio_tbl))[1]
    if (!is.na(rcol)) {
      hit <- ratio_tbl %>%
        filter(is.finite(.data[[rcol]]), .data[[rcol]] >= cfg$ratio_threshold) %>%
        transmute(gene = toupper(gene), ratio = .data[[rcol]])
      msg("  %s >= %.1f : %d genes", rcol, cfg$ratio_threshold, nrow(hit))
      parts$ratio <- hit
    }
  }

  if (!is.null(recur_tbl) && all(c("gene", "n_datasets") %in% names(recur_tbl))) {
    hit <- recur_tbl %>%
      filter(n_datasets >= cfg$min_marker_cohorts) %>%
      transmute(gene = toupper(gene), n_marker_cohorts = n_datasets)
    msg("  marker in >= %d cohorts : %d genes", cfg$min_marker_cohorts, nrow(hit))
    parts$marker <- hit
  }

  if (!length(parts)) return(NULL)

  uni <- Reduce(function(a, b) full_join(a, b, by = "gene"), parts) %>%
    mutate(
      via_tau    = !is.na(tau %||% NA),
      via_ratio  = !is.na(ratio %||% NA),
      via_marker = !is.na(n_marker_cohorts %||% NA)
    )
  uni
}

`%||%` <- function(a, b) if (is.null(a)) b else a

