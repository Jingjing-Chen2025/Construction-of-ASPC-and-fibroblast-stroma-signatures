hdr("STEP 7 — stability selection, %d bootstraps", cfg$stability_boot)

bootstrap_freq <- function(y_vec, X, alpha, label) {
  ok <- is.finite(y_vec) & apply(X, 1, function(r) all(is.finite(r)))
  X2 <- X[ok, , drop = FALSE]; y2 <- as.numeric(y_vec[ok])
  n <- length(y2); nf <- min(cfg$nfolds, n)
  counts <- setNames(rep(0L, ncol(X2)), colnames(X2)); n_ok <- 0L

  for (b in seq_len(cfg$stability_boot)) {
    idx <- sample(seq_len(n), size = n, replace = TRUE)
    if (stats::sd(y2[idx]) < 1e-8) next
    cv <- tryCatch(glmnet::cv.glmnet(X2[idx, , drop = FALSE], y2[idx],
                                     alpha = alpha, standardize = TRUE, nfolds = nf),
                   error = function(e) NULL)
    if (is.null(cv)) next
    bb <- as.matrix(coef(cv, s = cfg$lambda_rule))
    bb <- bb[setdiff(rownames(bb), "(Intercept)"), 1]
    sel <- abs(bb) > cfg$coef_eps
    counts[names(sel)] <- counts[names(sel)] + as.integer(sel)
    n_ok <- n_ok + 1L
    if (b %% 20 == 0) msg("  %s: bootstrap %d / %d", label, b, cfg$stability_boot)
  }
  if (n_ok == 0) {
    warn_msg("  %s: no bootstrap succeeded.", label)
    return(setNames(rep(NA_real_, ncol(X2)), colnames(X2)))
  }
  msg("  %s: %d/%d bootstraps usable", label, n_ok, cfg$stability_boot)
  counts / n_ok
}

freq_nepc <- bootstrap_freq(as.numeric(NEPC_score),    X, fit_nepc$alpha, "NEPC_score")
freq_aspc <- bootstrap_freq(as.numeric(ASPC_fraction), X, fit_aspc$alpha, "ASPC_fraction")

sg <- sort(unique(c(names(freq_nepc), names(freq_aspc))))
fn <- as.numeric(freq_nepc[sg]); fa <- as.numeric(freq_aspc[sg])

# v3: explicit joint minimum. pmin(..., na.rm = TRUE) returns the non-NA side
# when one is NA, which overstates joint stability.
fmin <- ifelse(is.na(fn) | is.na(fa), NA_real_, pmin(fn, fa))

stability_tbl <- tibble::tibble(
  gene = sg,
  stability_freq      = fn,     # NEPC — the column 06_ reads
  stability_freq_aspc = fa,
  stability_freq_min  = fmin
) %>%
  dplyr::mutate(
    stability_selected      = !is.na(stability_freq) & stability_freq >= cfg$stability_cutoff,
    stability_selected_both = !is.na(stability_freq_min) & stability_freq_min >= cfg$stability_cutoff
  ) %>%
  dplyr::arrange(dplyr::desc(stability_freq_min), dplyr::desc(stability_freq))

msg("Stable for NEPC (>= %.2f) : %d genes", cfg$stability_cutoff,
    sum(stability_tbl$stability_selected, na.rm = TRUE))
msg("Stable for BOTH targets   : %d genes",
    sum(stability_tbl$stability_selected_both, na.rm = TRUE))

cat("\n  stability_freq distribution (NEPC / ASPC / joint):\n")
for (th in c(0.10, 0.20, 0.30, 0.40, 0.50, 0.60, 0.80)) {
  cat(sprintf("    >= %.2f : %5d / %5d / %5d\n", th,
              sum(fn >= th, na.rm = TRUE), sum(fa >= th, na.rm = TRUE),
              sum(fmin >= th, na.rm = TRUE)))
}
if (sum(stability_tbl$stability_selected, na.rm = TRUE) == 0) {
  warn_msg("Nothing clears the cutoff. Do NOT lower cfg$stability_cutoff to")
  warn_msg("  manufacture hits — with p/n = %.0f, non-reproducible selection is",
           ncol(X) / nrow(X))
  warn_msg("  the finding. Record it and let 06_ drop the channel.")
}

