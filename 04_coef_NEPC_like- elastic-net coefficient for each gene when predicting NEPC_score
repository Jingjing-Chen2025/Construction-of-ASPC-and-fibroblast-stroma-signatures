zscale_rows <- function(mat) t(scale(t(mat)))
score_from_genes <- function(gset, mat) {
  gset <- intersect(toupper(gset), rownames(mat))
  if (!length(gset)) { warn_msg("  No signature genes in matrix."); 
    return(setNames(rep(NA_real_, ncol(mat)), colnames(mat))) }
  setNames(colMeans(zscale_rows(mat[gset, , drop = FALSE]), na.rm = TRUE), colnames(mat))
}

