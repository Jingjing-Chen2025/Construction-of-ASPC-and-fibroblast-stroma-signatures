           nrow(datExpr), ncol(datExpr))
}

if (isTRUE(cfg$residualize)) {
  msg("Residualising on: %s", paste(cfg$resid_covariates, collapse = ", "))
  msg("  (ASPC_fraction deliberately excluded — it is a prediction target)")

  cov_use <- cov_tbl %>% dplyr::select(dplyr::any_of(cfg$resid_covariates))

  is_const <- vapply(cov_use, function(v) sd(v, na.rm = TRUE) < 1e-8, logical(1))
  if (any(is_const)) {
    warn_msg("  Dropping near-constant covariates: %s",
             paste(names(cov_use)[is_const], collapse = ", "))
    cov_use <- cov_use[, !is_const, drop = FALSE]
  }

  if (ncol(cov_use) > 0) {
    Xcov <- model.matrix(~ ., data = cov_use)
    Y <- as.matrix(datExpr)

    # Single QR solve for all genes at once (v1 looped lm.fit per gene)
    qrX <- qr(Xcov)
    if (qrX$rank < ncol(Xcov)) {
      warn_msg("  Covariate matrix is rank-deficient (rank %d of %d); using QR pivoting.",
               qrX$rank, ncol(Xcov))
    }
    resid_mat <- qr.resid(qrX, Y)
    dimnames(resid_mat) <- dimnames(Y)
    datExpr <- resid_mat
    msg("  Residualisation complete (%d genes in one solve).", ncol(Y))
  } else {
    warn_msg("  No usable covariates; skipping residualisation.")
  }
}

