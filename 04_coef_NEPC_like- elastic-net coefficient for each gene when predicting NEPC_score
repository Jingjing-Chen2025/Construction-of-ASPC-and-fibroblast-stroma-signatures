hdr("STEP 0 — namespace conflicts")

report_masking <- function(fns = c("select","filter","mutate","arrange","rename",
                                   "slice","count","first","cor","sd","var","median")) {
  found <- FALSE
  for (f in fns) {
    wh <- utils::getAnywhere(f)
    pk <- unique(wh$where[grepl("^package:", wh$where)])
    pk <- sub("^package:", "", pk)
    if (length(pk) > 1) {
      found <- TRUE
      cat(sprintf("  %-8s resolves from '%s'  (also in: %s)\n",
                  f, pk[1], paste(pk[-1], collapse = ", ")))
    }
  }
  if (found) {
    msg("  All verbs below are namespace-qualified, so this masking is harmless.")
    msg("  v2 crashed here: edgeR pulls in AnnotationDbi, whose select() is an")
    msg("  S4 generic with no tbl_df method.")
  } else msg("  No masking detected.")
}
report_masking()

