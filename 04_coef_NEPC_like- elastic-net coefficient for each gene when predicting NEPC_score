hdr("STEP 5 — design matrix")

datExpr <- t(logCPM[aspc_features_bulk, , drop = FALSE])
msg("Design matrix: %d samples x %d features", nrow(datExpr), ncol(datExpr))

if (ncol(datExpr) > 10 * nrow(datExpr)) {
  warn_msg("p/n = %.0f. Individual coefficients are not identifiable; stability",
           ncol(datExpr) / nrow(datExpr))
  warn_msg("  selection is the more informative output, and if nothing is stable")
  warn_msg("  that is the honest conclusion.")
}

if (isTRUE(cfg$residualize)) {
  msg("Residualising on: %s", paste(cfg$resid_covariates, collapse = ", "))
  msg("  ASPC_fraction EXCLUDED — it is a prediction target. Residualising on")
  msg("  it and then predicting it would force those coefficients to ~0.")

  cov_use <- cov_tbl %>% dplyr::select(dplyr::any_of(cfg$resid_covariates))
  is_const <- vapply(cov_use, function(v) stats::sd(v, na.rm = TRUE) < 1e-8, logical(1))
  if (any(is_const)) {
    warn_msg("  Dropping near-constant covariates: %s",
             paste(names(cov_use)[is_const], collapse = ", "))
    cov_use <- cov_use[, !is_const, drop = FALSE]
  }

  if ("stromal_fraction" %in% names(cov_use)) {
    rs <- suppressWarnings(stats::cor(ASPC_fraction, cov_use$stromal_fraction,
                                      use = "pairwise.complete.obs"))
    msg("  cor(ASPC_fraction, stromal_fraction) = %.3f", rs)
    if (!is.na(rs) && abs(rs) > 0.8) {
      warn_msg("  Near-collinear. Residualising X on stromal_fraction removes most")
      warn_msg("  of the variance the ASPC task needs; expect few non-zero coefs.")
    }
  }

  if (ncol(cov_use) > 0) {
    Xcov <- stats::model.matrix(~ ., data = cov_use)
    Y <- as.matrix(datExpr)
    qrX <- qr(Xcov)
    if (qrX$rank < ncol(Xcov)) {
      warn_msg("  Covariate matrix rank-deficient (%d of %d); QR pivoting applied.",
               qrX$rank, ncol(Xcov))
    }
    resid_mat <- qr.resid(qrX, Y)
    dimnames(resid_mat) <- dimnames(Y)
    datExpr <- resid_mat
    msg("  Residualised %d genes in one QR solve.", ncol(Y))
  } else warn_msg("  No usable covariates; skipping residualisation.")
}

X <- as.matrix(datExpr)
ok_cols <- apply(X, 2, function(v) all(is.finite(v)) && stats::sd(v) > 1e-8)
X <- X[, ok_cols, drop = FALSE]
msg("Features after finite/variance filter: %d (dropped %d)",
