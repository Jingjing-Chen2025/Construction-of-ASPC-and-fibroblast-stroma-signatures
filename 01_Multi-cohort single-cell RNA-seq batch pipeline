# ============================================================================
# GENERIC HELPERS
# ============================================================================
sanitize_gene_names <- function(x) {
  x <- as.character(x); x <- str_trim(x)
  x <- gsub("\uFEFF", "", x, fixed = TRUE)
  x <- gsub("\r", "", x, fixed = TRUE)
  x <- gsub('"', "", x, fixed = TRUE)
  x[x == "" | is.na(x)] <- "NA_FEATURE"
  x
}

sanitize_cell_names <- function(x) {
  x <- as.character(x); x <- str_trim(x)
  x <- gsub("\uFEFF", "", x, fixed = TRUE)
  x <- gsub("\r", "", x, fixed = TRUE)
  x <- gsub('"', "", x, fixed = TRUE)
  x[x == "" | is.na(x)] <- "NA_CELL"
  x
}

collapse_duplicate_features <- function(mat) {
  rn <- rownames(mat)
  if (is.null(rn) || !any(duplicated(rn))) return(mat)
  msg("  Collapsing %d duplicated feature name(s).", sum(duplicated(rn)))
  f <- factor(rn, levels = unique(rn))
  G <- Matrix::sparse.model.matrix(~ 0 + f)
  agg <- Matrix::t(G) %*% mat
  rownames(agg) <- levels(f)
  agg
}

finalize_matrix <- function(mat) {
  if (!inherits(mat, "dgCMatrix")) mat <- as(mat, "dgCMatrix")
  rownames(mat) <- sanitize_gene_names(rownames(mat))
  colnames(mat) <- make.unique(sanitize_cell_names(colnames(mat)))
  collapse_duplicate_features(mat)
}

check_not_spatial <- function(n_barcodes, sample_name, dir_path = NULL) {
  if (!is.null(dir_path) && dir.exists(dir_path)) {
    hits <- list.files(dir_path,
      pattern = "tissue_positions|scalefactors_json|tissue_(hi|low)res_image",
      recursive = TRUE)
    if (length(hits)) {
      warn_msg("[SPATIAL] %s contains Space Ranger files (%s). Barcodes are SPOTS, not cells.",
               sample_name, paste(head(hits, 3), collapse = ", "))
    }
  }
  if (n_barcodes <= 4992) {
    warn_msg("[SPATIAL?] %s has only %d barcodes (<= 4992, the Visium maximum). Verify Cell Ranger origin.",
             sample_name, n_barcodes)
  }
  invisible(NULL)
}

open_maybe_gz <- function(path) if (grepl("\\.gz$", path)) gzfile(path) else file(path)

peek_lines <- function(path, n = 5) {
  con <- open_maybe_gz(path)
  on.exit(close(con), add = TRUE)
  readLines(con, n = n, warn = FALSE)
}

detect_sep <- function(lines) {
  if (!length(lines)) return("\t")
  counts <- c(
    "\t" = max(lengths(strsplit(lines, "\t", fixed = TRUE))) - 1,
    ","  = max(lengths(strsplit(lines, ",",  fixed = TRUE))) - 1,
    " "  = max(lengths(strsplit(lines, " ",  fixed = TRUE))) - 1
  )
  names(which.max(counts))
}

looks_like_barcodes <- function(x, n = 200) {
  x <- head(as.character(x), n)
  if (!length(x)) return(FALSE)
  frac_acgt <- mean(grepl("^[ACGTN]{8,}(-[0-9]+)?$", toupper(x)))
  frac_long <- mean(nchar(x) >= 14)
  frac_acgt > 0.5 || frac_long > 0.7
}

sniff_table <- function(path, sample_name) {
  lines <- peek_lines(path, n = 3)
  sep <- detect_sep(lines)
  hdr_n  <- length(strsplit(lines[1], sep, fixed = TRUE)[[1]])
  data_n <- if (length(lines) >= 2) length(strsplit(lines[2], sep, fixed = TRUE)[[1]]) else hdr_n
  msg("  %s: sep='%s'  header_fields=%d  data_fields=%d",
      sample_name, ifelse(sep == "\t", "\\t", sep), hdr_n, data_n)
  list(sep = sep, header_fields = hdr_n, data_fields = data_n,
       offset = (data_n == hdr_n + 1))
}

# ============================================================================
# v3 — MATRIX FILE CLASSIFICATION (raw counts vs processed values)
# ============================================================================
classify_matrix_file <- function(path, label = basename(path)) {
  out <- list(
    file = basename(path), path = path,
    size_mb = round(file.info(path)$size / 1024^2, 2),
    sep = NA_character_, n_fields = NA_integer_,
    all_integer = NA, has_negative = NA,
    min_val = NA_real_, max_val = NA_real_,
    pct_zero = NA_real_, verdict = "unknown", reason = ""
  )

  lines <- tryCatch(peek_lines(path, n = cfg$classify_n_rows + 1),
                    error = function(e) character(0))
  if (length(lines) < 2) {
    out$verdict <- "unreadable"; out$reason <- "fewer than 2 lines"; return(out)
  }

  sep <- detect_sep(lines)
  out$sep <- ifelse(sep == "\t", "\\t", sep)

  vals <- unlist(lapply(lines[-1], function(l) {
    f <- strsplit(l, sep, fixed = TRUE)[[1]]
    if (length(f) < 2) return(numeric(0))
    suppressWarnings(as.numeric(f[2:min(length(f), cfg$classify_n_cols + 1)]))
  }))
  vals <- vals[is.finite(vals)]

  out$n_fields <- length(strsplit(lines[2], sep, fixed = TRUE)[[1]])
  if (!length(vals)) {
    out$verdict <- "no_numeric"; out$reason <- "no parseable numeric values"; return(out)
  }

  out$all_integer  <- all(abs(vals - round(vals)) < 1e-8)
  out$has_negative <- any(vals < 0)
  out$min_val      <- min(vals)
  out$max_val      <- max(vals)
  out$pct_zero     <- round(100 * mean(vals == 0), 1)

  fname_raw <- grepl("raw", basename(path), ignore.case = TRUE)

  if (out$has_negative) {
    out$verdict <- "processed"; out$reason <- "negative values present (scaled / z-scored)"
  } else if (isTRUE(out$all_integer)) {
    out$verdict <- "raw_counts"
    out$reason  <- if (fname_raw) "integer values and 'raw' in filename" else "integer values"
  } else {
    out$verdict <- "processed"; out$reason <- "non-integer values (normalised / log-transformed)"
  }
  out
}

triage_duplicate_matrices <- function(samples, dir_path, cohort_name) {
  collide_types <- c("matrix_txt", "matrix_csv", "labelled_csv", "dense_csv", "gene_cell_table")
  idx <- which(vapply(samples, function(s) s$type %in% collide_types && !is.null(s$path), logical(1)))
  if (!length(idx)) return(list(samples = samples, report = NULL))

  gsm_of <- function(s) {
    m <- regmatches(s$sample_id, regexpr("^GSM[0-9]+", s$sample_id))
    if (length(m)) m else s$sample_id
  }
  keys <- vapply(samples[idx], gsm_of, character(1))
  dup_keys <- unique(keys[duplicated(keys)])
  if (!length(dup_keys)) return(list(samples = samples, report = NULL))

  msg("Duplicate matrices detected for %d accession(s): %s",
      length(dup_keys), paste(dup_keys, collapse = ", "))

  report <- list(); drop_idx <- integer(0)

  for (k in dup_keys) {
    grp <- idx[keys == k]
    cls <- lapply(samples[grp], function(s) classify_matrix_file(s$path))

    for (i in seq_along(grp)) {
      c_i <- cls[[i]]
      msg("  %-42s %-11s  int=%-5s neg=%-5s range=[%g, %g]  zero=%.1f%%  %.1f MB",
          c_i$file, c_i$verdict, c_i$all_integer, c_i$has_negative,
          c_i$min_val, c_i$max_val, c_i$pct_zero, c_i$size_mb)
    }

    is_raw_name <- grepl("raw", vapply(cls, function(c) c$file, character(1)), ignore.case = TRUE)
    is_raw_val  <- vapply(cls, function(c) identical(c$verdict, "raw_counts"), logical(1))

    pick <- switch(cfg$matrix_preference,
      raw       = if (any(is_raw_val & is_raw_name)) which(is_raw_val & is_raw_name)[1]
                  else if (any(is_raw_val)) which(is_raw_val)[1]
                  else if (any(is_raw_name)) which(is_raw_name)[1]
                  else 1L,
      processed = if (any(!is_raw_name)) which(!is_raw_name)[1] else 1L,
      auto      = if (any(is_raw_val)) which(is_raw_val)[1] else 1L,
      1L
    )

    msg("  -> keeping %s (preference='%s'); skipping %d other file(s)",
        cls[[pick]]$file, cfg$matrix_preference, length(grp) - 1)

    drop_idx <- c(drop_idx, grp[-pick])

    for (i in seq_along(grp)) {
      report[[length(report) + 1]] <- data.frame(
        cohort = cohort_name, accession = k,
        file = cls[[i]]$file, size_mb = cls[[i]]$size_mb,
        sep = cls[[i]]$sep, n_fields = cls[[i]]$n_fields,
        all_integer = cls[[i]]$all_integer, has_negative = cls[[i]]$has_negative,
        min_val = cls[[i]]$min_val, max_val = cls[[i]]$max_val,
        pct_zero = cls[[i]]$pct_zero,
        verdict = cls[[i]]$verdict, reason = cls[[i]]$reason,
        selected = (i == pick), preference = cfg$matrix_preference,
        stringsAsFactors = FALSE)
    }
  }

  if (length(drop_idx)) samples <- samples[-drop_idx]
  list(samples = samples, report = if (length(report)) bind_rows(report) else NULL)
}

# ---- v2 FIX 1: chunked dense -> sparse conversion -------------------------
df_to_sparse_by_chunks <- function(df, chunk = cfg$chunk_cols, label = "") {
  nc <- ncol(df)
  if (nc == 0) stop("No numeric columns to convert (", label, ")")
  starts <- seq(1, nc, by = chunk)
  blocks <- vector("list", length(starts))

  for (i in seq_along(starts)) {
    a <- starts[i]; b <- min(a + chunk - 1, nc)
    blk <- as.matrix(df[, a:b, drop = FALSE])
    suppressWarnings(storage.mode(blk) <- "double")
    blk[is.na(blk)] <- 0
    blocks[[i]] <- as(blk, "dgCMatrix")
    rm(blk)
    if (i %% 5 == 0 || i == length(starts)) gc(verbose = FALSE)
  }
  out <- if (length(blocks) == 1) blocks[[1]] else do.call(cbind, blocks)
  rm(blocks); gc(verbose = FALSE)
  out
}

