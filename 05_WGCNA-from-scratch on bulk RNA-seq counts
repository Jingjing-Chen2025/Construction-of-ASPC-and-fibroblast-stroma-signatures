traits <- traits[, keep_tr, drop = FALSE]
msg("Traits tested: %s", paste(colnames(traits), collapse = ", "))

nSamples <- nrow(datExpr)
moduleTraitCor <- stats::cor(MEs, traits, use = "pairwise.complete.obs")
moduleTraitP   <- WGCNA::corPvalueStudent(moduleTraitCor, nSamples)

# rows are MODULES (colnames of MEs); rownames(MEs) are SAMPLES
stopifnot(nrow(moduleTraitCor) == ncol(MEs))
msg("Matrix: %d modules x %d traits", nrow(moduleTraitCor), ncol(moduleTraitCor))

mt_tbl <- as.data.frame(moduleTraitCor) %>%
  tibble::rownames_to_column("ME") %>%
  tidyr::pivot_longer(-ME, names_to = "trait", values_to = "r") %>%
  dplyr::left_join(
    as.data.frame(moduleTraitP) %>%
      tibble::rownames_to_column("ME") %>%
      tidyr::pivot_longer(-ME, names_to = "trait", values_to = "p"),
    by = c("ME", "trait")) %>%
  dplyr::mutate(module = sub("^ME", "", ME),
                fdr = stats::p.adjust(p, method = "BH")) %>%
  dplyr::select(module, ME, trait, r, p, fdr) %>%
  dplyr::arrange(trait, dplyr::desc(abs(r)))

# CSV first — nothing downstream should depend on a plot succeeding
