# ============================================================================
hdr("STEP 6 — residualisation")

if (isTRUE(cfg$residualize) && nrow(cov_tbl) == nrow(datExpr)) {
  msg("Residualising on: %s", paste(cfg$resid_covariates, collapse = ", "))
  msg("  ASPC_fraction EXCLUDED — it is the module-trait target. Removing it")
  msg("  would eliminate the ASPC module by construction (the v1 defect).")

  cov_use <- cov_tbl %>% dplyr::select(dplyr::any_of(cfg$resid_covariates))
  is_const <- vapply(cov_use, function(v) stats::sd(v, na.rm = TRUE) < 1e-8, logical(1))
  if (any(is_const)) {
    warn_msg("  Dropping near-constant covariates: %s",
             paste(names(cov_use)[is_const], collapse = ", "))
    cov_use <- cov_use[, !is_const, drop = FALSE]
  }

  if (ncol(cov_use) > 0) {
    Xcov <- stats::model.matrix(~ ., data = cov_use)
    Y <- as.matrix(datExpr)
    qrX <- qr(Xcov)
    if (qrX$rank < ncol(Xcov)) {
      warn_msg("  Covariate matrix rank-deficient (%d of %d); QR pivoting handles it.",
               qrX$rank, ncol(Xcov))
    }
    resid_mat <- qr.resid(qrX, Y)
    dimnames(resid_mat) <- dimnames(Y)
    datExpr <- as.data.frame(resid_mat)
    msg("  Residualised %d genes in a single QR solve.", ncol(Y))
  } else warn_msg("  No usable covariates; skipping.")
} else msg("Residualisation disabled.")

