# ---- v3: grey is the unassigned bin, not a module ----
grey_rows <- mt_tbl %>%
  dplyr::filter(module == "grey", fdr < cfg$trait_fdr) %>%
  dplyr::arrange(dplyr::desc(abs(r)))
if (nrow(grey_rows) && abs(grey_rows$r[1]) > cfg$grey_warn_r) {
  warn_msg("GREY correlates with %s at r = %+.3f (FDR %.1e).",
           grey_rows$trait[1], grey_rows$r[1], grey_rows$fdr[1])
  warn_msg("  Grey is the UNASSIGNED bin — its eigengene is the first PC of genes")
  warn_msg("  that failed to cluster. A correlation this strong means real")
  warn_msg("  structure was missed, often because the power fragmented a genuine")
  warn_msg("  module. Grey is excluded from selection; do not report it.")
  warn_msg("  Consider mergeCutHeight 0.30 or a lower power.")
}

# ---- identify ASPC-associated modules ----
aspc_mt <- mt_tbl %>% dplyr::filter(trait == "ASPC_fraction", module != "grey")

aspc_modules <- aspc_mt %>%
  dplyr::filter(fdr < cfg$trait_fdr, abs(r) >= cfg$trait_min_r) %>%
  dplyr::pull(module)

aspc_selection_mode <- "significant"
if (!length(aspc_modules)) {
  warn_msg("No module reaches FDR < %.2f AND |r| >= %.2f for ASPC_fraction.",
           cfg$trait_fdr, cfg$trait_min_r)
  warn_msg("  Falling back to the single strongest-correlated module. This is")
  warn_msg("  WEAK evidence and is recorded as such — 06_ should weight it low.")
  aspc_modules <- aspc_mt %>% dplyr::slice_max(abs(r), n = 1) %>% dplyr::pull(module)
  aspc_selection_mode <- "fallback_best_r"
}

msg("ASPC-associated module(s) [%s]: %s",
    aspc_selection_mode, paste(aspc_modules, collapse = ", "))
for (m in aspc_modules) {
  row <- aspc_mt %>% dplyr::filter(module == m)
  rs <- mt_tbl %>% dplyr::filter(module == m, trait == "stromal_fraction")
  msg("  %-14s r_ASPC = %+.3f  p = %.2e  FDR = %.2e  (%d genes)",
      m, row$r[1], row$p[1], row$fdr[1], sum(moduleColors == m))
  if (nrow(rs) && !is.na(rs$r[1]) && abs(rs$r[1]) > abs(row$r[1])) {
    warn_msg("    Correlates MORE with stromal_fraction (%+.3f) than with ASPC",
             rs$r[1])
    warn_msg("    content — probably a general stromal module.")
  }
}

