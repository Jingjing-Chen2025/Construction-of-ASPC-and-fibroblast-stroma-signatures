# a plot must never be able to destroy a completed analysis
safe_plot <- function(expr, label) {
  tryCatch(force(expr), error = function(e) {
    warn_msg("Plot '%s' failed: %s", label, conditionMessage(e))
    warn_msg("  CSV outputs are unaffected.")
    while (grDevices::dev.cur() > 1) grDevices::dev.off()
    invisible(NULL)
  })
}

