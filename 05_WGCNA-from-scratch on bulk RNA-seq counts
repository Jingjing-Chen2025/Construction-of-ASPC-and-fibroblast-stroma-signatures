read_cov <- function(path, needed_cols) {
  if (!file.exists(path)) { warn_msg("Missing covariate file: %s", path); return(tibble::tibble()) }
  df <- suppressMessages(readr::read_csv(path, show_col_types = FALSE)) %>% tibble::as_tibble()
  miss <- setdiff(needed_cols, names(df))
  if (length(miss)) warn_msg("%s missing columns: %s", basename(path), paste(miss, collapse = ", "))
  df
}

