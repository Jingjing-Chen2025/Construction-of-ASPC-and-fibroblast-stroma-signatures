hdr("STEP 0 — namespace conflicts")

report_masking <- function(fns = c("select","filter","mutate","arrange","rename",
                                   "slice","count","first","cor","sd","var",
                                   "median","dist","combine")) {
  found <- FALSE
  for (f in fns) {
    wh <- utils::getAnywhere(f)
    pk <- unique(wh$where[grepl("^package:", wh$where)])
    pk <- sub("^package:", "", pk)
    if (length(pk) > 1) {
      found <- TRUE
      cat(sprintf("  %-8s resolves from '%s'  (also in: %s)\n",
                  f, pk[1], paste(pk[-1], collapse = ", ")))
    }
  }
  if (found) {
    msg("  Every verb below is namespace-qualified, so this masking is harmless.")
    msg("  v2 died here: edgeR pulls in AnnotationDbi, whose select() is an S4")
    msg("  generic with no tbl_df method. WGCNA also masks cor() and dist().")
  } else msg("  No masking detected.")
}
report_masking()

