mod_summary <- membership_tbl %>%
  group_by(module) %>%
  summarise(n_genes = n(),
            median_kME = median(kME_abs, na.rm = TRUE),
            n_tau_high = sum(tau_sc >= 0.80, na.rm = TRUE),
            n_ratio_high = sum(ratio_sc >= 2, na.rm = TRUE),
            .groups = "drop") %>%
  left_join(mt_tbl %>% filter(trait == "ASPC_fraction") %>%
              select(module, r_ASPC = r, fdr_ASPC = fdr), by = "module") %>%
  left_join(mt_tbl %>% filter(trait == "NEPC_score") %>%
              select(module, r_NEPC = r, fdr_NEPC = fdr), by = "module") %>%
  mutate(is_aspc_module = module %in% aspc_modules) %>%
  arrange(desc(is_aspc_module), desc(abs(r_ASPC)))

