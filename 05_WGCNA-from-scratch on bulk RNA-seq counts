msg("in_any_module   TRUE (v1 permissive definition)   : %d", n_any)

frac <- n_aspc / max(1, nrow(membership_tbl))
if (frac > 0.35) {
  warn_msg("The ASPC module covers %.0f%% of the network. A module this large is",
           100 * frac)
  warn_msg("  usually the dominant variance axis rather than a specific programme,")
  warn_msg("  so in_wgcna_module will fire for most candidates and cannot")
  warn_msg("  discriminate in 06_. Consider a lower mergeCutHeight.")
}
if (n_aspc == 0) {
  warn_msg("NO gene passes. 06_'s module channel will contribute nothing.")
  warn_msg("  kME distribution within the selected module(s):")
  print(summary(membership_tbl$kME_abs[membership_tbl$aspc_module]))
}

if ("tau_sc" %in% names(membership_tbl)) {
  ov <- membership_tbl %>% dplyr::filter(in_wgcna_module, !is.na(tau_sc))
  if (nrow(ov)) {
