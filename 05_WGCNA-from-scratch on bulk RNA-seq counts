own_col <- paste0("kME", mod_of_gene)
valid <- own_col %in% colnames(kME_mat) & mod_of_gene != "grey"

kME_own <- rep(NA_real_, length(gene_ids))
if (any(valid)) {
  idx <- cbind(match(gene_ids[valid], rownames(kME_mat)),
               match(own_col[valid],  colnames(kME_mat)))
  kME_own[valid] <- kME_mat[idx]
}

membership_tbl <- tibble::tibble(
  gene    = toupper_trim(gene_ids),
  module  = mod_of_gene,
  kME     = as.numeric(kME_own),
  kME_abs = abs(as.numeric(kME_own))
) %>%
  dplyr::mutate(
    # v1 definition, retained for transparency
    in_any_module   = !is.na(kME) & module != "grey" & kME_abs >= cfg$kme_cutoff,
    # v2/v3 definition — restricted to ASPC-ASSOCIATED modules
    aspc_module     = module %in% aspc_modules,
    in_wgcna_module = aspc_module & !is.na(kME) & kME_abs >= cfg$kme_cutoff
  )

# ---- attach single-cell evidence from 02_ / 03_ ----
RATIO_CANDIDATES <- c("target_specific_ratio", "aspc_specific_ratio",
                      "ratio_max", "ratio_mean")

attach_sc <- function(tbl, group_name, root) {
  tau_path   <- file.path(root, sprintf("tau_%s_all_datasets.csv", group_name))
  ratio_path <- file.path(root, sprintf("ratio_%s_all_datasets.csv", group_name))

  if (file.exists(tau_path)) {
    tt <- suppressMessages(readr::read_csv(tau_path, show_col_types = FALSE)) %>%
      dplyr::transmute(gene = toupper(gene), tau_sc = tau)
    tbl <- dplyr::left_join(tbl, tt, by = "gene")
    msg("Attached tau from 02_: %d genes matched", sum(!is.na(tbl$tau_sc)))
  } else warn_msg("02_ tau table not found: %s", basename(tau_path))

  if (file.exists(ratio_path)) {
    rt <- suppressMessages(readr::read_csv(ratio_path, show_col_types = FALSE))
    rcol <- intersect(RATIO_CANDIDATES, names(rt))[1]
    if (!is.na(rcol)) {
      msg("  ratio column in use: %s", rcol)
      rt <- rt %>% dplyr::transmute(gene = toupper(gene), ratio_sc = .data[[rcol]])
      tbl <- dplyr::left_join(tbl, rt, by = "gene")
      msg("Attached ratio from 03_: %d genes matched", sum(!is.na(tbl$ratio_sc)))
    } else warn_msg("  No recognised ratio column in %s", basename(ratio_path))
  } else warn_msg("03_ ratio table not found: %s", basename(ratio_path))

  tbl
}

membership_tbl <- attach_sc(membership_tbl, cfg$annotate_group, cfg$annotate_root) %>%
  dplyr::arrange(dplyr::desc(in_wgcna_module), dplyr::desc(kME_abs))

