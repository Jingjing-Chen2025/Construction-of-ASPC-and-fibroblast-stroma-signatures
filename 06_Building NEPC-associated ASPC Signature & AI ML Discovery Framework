load_sample_table <- function(path, label) {
  df <- read_csv_input(path, label)
  if (is.null(df)) return(NULL)

  if (!"sample" %in% names(df)) {
    warn_msg("%s lacks sample column; ignoring.", label)
    return(NULL)
  }

  df$sample <- trimws(as.character(df$sample))

  if (anyDuplicated(df$sample)) {
    stop(label, " contains duplicated sample IDs.")
  }

  df
}

extract_sample_vector <- function(df, column, samples) {
  out <- setNames(rep(NA_real_, length(samples)), samples)

  if (is.null(df) || !column %in% names(df)) {
    warn_msg("%s unavailable.", column)
    return(out)
  }

  values <- to_num(df[[column]])
  out[] <- values[match(samples, df$sample)]
  out
}

