    warn_msg("Missing ratio CSV: %s", path)
    return(NULL)
  }
  readr::read_csv(path, show_col_types = FALSE) %>%
    dplyr::mutate(
      gene = toupper(as.character(gene)),
      aspc_specific_ratio = suppressWarnings(as.numeric(aspc_specific_ratio)),
      dataset = basename(path)
    ) %>%
    dplyr::filter(!is.na(gene) & gene != "")
}

aggregate_ratio_features <- function(df_all, prefix, thr) {
  if (is.null(df_all) || nrow(df_all) == 0) return(NULL)

  df_all %>%
    dplyr::group_by(gene) %>%
    dplyr::summarise(
      "{prefix}_median" := median(aspc_specific_ratio, na.rm = TRUE),
      "{prefix}_mean"   := mean(aspc_specific_ratio, na.rm = TRUE),
      "{prefix}_max"    := max(aspc_specific_ratio, na.rm = TRUE),
      "{prefix}_present_frac" := mean(aspc_specific_ratio > thr, na.rm = TRUE),
      "{prefix}_n_datasets" := dplyr::n_distinct(dataset),
      .groups = "drop"
    )
}

