build_evidence <- function(cand_genes, atlas_tbl, tau_col) {
  tibble::tibble(gene = intersect(cand_genes, rownames(expr_mat))) %>%
    dplyr::mutate(
      is_secreted         = gene %in% secreted,
      is_ecm              = gene %in% matrisome,
      is_ligand           = gene %in% ligands | gene %in% c("TNFSF12", "MDK"),
      is_metabolic        = gene %in% metabolic,
      is_TF_Cof_Chromatin = gene %in% tf_cof_chromatin
    ) %>%
    dplyr::left_join(ensure_joinable(sc_tbl, sc_cols), by = "gene") %>%
    dplyr::left_join(ensure_joinable(partial_corr_tbl, c("gene","partial_corr")), by = "gene") %>%
    dplyr::left_join(ensure_joinable(wgcna_membership,
                     c("gene","kME","in_wgcna_module","in_any_module")), by = "gene") %>%
    dplyr::left_join(ensure_joinable(multi_task_tbl,
                     c("gene","coef_NEPC_like","coef_ASPC_fraction",
                       "multi_task_positive")), by = "gene") %>%
    dplyr::left_join(ensure_joinable(stability_tbl,
                     c("gene","stability_freq","stability_selected")), by = "gene") %>%
    dplyr::left_join(ensure_joinable(atlas_tbl, c("gene","atlas_supported")), by = "gene") %>%
    dplyr::left_join(cor_tbl, by = "gene") %>%
    dplyr::mutate(
      tau_used            = .data[[tau_col]],
      high_tau            = !is.na(tau_used) & tau_used >= cfg$tau_threshold,
      high_partial_corr   = !is.na(partial_corr) & partial_corr >= cfg$partial_corr_threshold,
      atlas_supported     = dplyr::coalesce(as.logical(atlas_supported), FALSE),
      multi_task_positive = dplyr::coalesce(as.logical(multi_task_positive), FALSE),
      in_wgcna_module     = dplyr::coalesce(as.logical(in_wgcna_module), FALSE),
      in_any_module       = dplyr::coalesce(as.logical(in_any_module), FALSE),
      stability_selected  = dplyr::coalesce(as.logical(stability_selected), FALSE),
      is_TF_Cof_Chromatin = dplyr::coalesce(is_TF_Cof_Chromatin, FALSE),
      evidence_score =
        w$high_tau            * as.integer(high_tau) +
        w$high_partial_corr   * as.integer(high_partial_corr) +
        w$in_wgcna_module     * as.integer(in_wgcna_module) +
        w$multi_task_positive * as.integer(multi_task_positive) +
        w$stability_selected  * as.integer(stability_selected) +
        w$atlas_supported     * as.integer(atlas_supported) +
        w$is_ligand           * as.integer(is_ligand) +
        w$is_secreted         * as.integer(is_secreted) +
        w$is_ecm              * as.integer(is_ecm) +
        w$is_metabolic        * as.integer(is_metabolic) +
        w$is_TF_Cof_Chromatin * as.integer(is_TF_Cof_Chromatin)
    )
}

