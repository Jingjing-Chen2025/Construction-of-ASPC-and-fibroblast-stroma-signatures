hdr("STEP 9 — score-based ranking and signature construction")

rank_by_score <- function(df, score_column = "evidence_score") {
  # No secondary biological criteria:
  # gene symbol only resolves exact score ties deterministically.
  df %>%
    dplyr::arrange(
      dplyr::desc(.data[[score_column]]),
      gene
    )
}

select_signature <- function(df, label, exclude = character(0)) {
  all_ranked <- rank_by_score(df) %>%
    dplyr::mutate(
      candidate_rank = dplyr::row_number(),
      excluded_by_other_signature = gene %in% exclude
    )

  eligible_ranked <- all_ranked %>%
    dplyr::filter(!excluded_by_other_signature) %>%
    dplyr::mutate(
      eligible_rank = dplyr::row_number()
    )

  n_take <- min(cfg$target_size, nrow(eligible_ranked))

  selected <- eligible_ranked %>%
    dplyr::slice_head(n = n_take) %>%
    dplyr::mutate(
      signature_rank = dplyr::row_number(),
      selected = TRUE
    )

  # Attach eligible/selected ranks to the complete candidate ranking.
  all_ranked$eligible_rank <- match(
    all_ranked$gene,
    eligible_ranked$gene
  )
  all_ranked$signature_rank <- match(
    all_ranked$gene,
    selected$gene
  )
  all_ranked$selected <- !is.na(all_ranked$signature_rank)

  all_ranked <- all_ranked %>%
    dplyr::mutate(
      selection_status = dplyr::case_when(
        excluded_by_other_signature ~ "excluded_by_other_signature",
        selected ~ "selected",
        TRUE ~ "below_top_n"
      )
    )

  cutoff <- if (n_take > 0L) {
    selected$evidence_score[n_take]
  } else {
    NA_real_
  }

  diagnostics <- tibble::tibble(
    branch = label,
    selection_method = "evidence_score_desc_gene_asc",
    target_size = cfg$target_size,
    n_candidates_measured_in_bulk = nrow(df),
    n_excluded_by_other_signature =
      sum(all_ranked$excluded_by_other_signature),
    n_eligible = nrow(eligible_ranked),
    n_selected = n_take,
    target_shortfall = cfg$target_size - n_take,
    cutoff_evidence_score = cutoff,
    n_eligible_tied_at_cutoff = if (is.finite(cutoff)) {
      sum(eligible_ranked$evidence_score == cutoff)
    } else {
      0L
    },
    n_selected_zero_total_score =
      sum(selected$evidence_score == 0),
    n_selected_zero_measured_evidence =
      sum(selected$evidence_only_score == 0),
    n_selected_missing_tau =
      sum(!is.finite(selected$tau_used)),
    n_selected_missing_ratio =
      sum(!is.finite(selected$ratio_used)),
    n_selected_missing_partial_corr =
      sum(!is.finite(selected$partial_corr)),
    n_selected_surface = sum(selected$is_surface)
  )

  if (n_take < cfg$target_size) {
    warn_msg(
      "%s: selected %d/%d; candidate pool after exclusion is too small.",
      label, n_take, cfg$target_size
    )
  }

  if (any(selected$evidence_only_score == 0)) {
    warn_msg(
      "%s: %d selected genes have zero measured-evidence points.",
      label,
      sum(selected$evidence_only_score == 0)
    )
  }

  if (any(selected$evidence_score == 0)) {
    warn_msg(
      "%s: %d zero-total-score genes selected to fill the target.",
      label,
      sum(selected$evidence_score == 0)
    )
  }

  # Internal ordering and membership checks.
  stopifnot(
    nrow(selected) <= cfg$target_size,
    !anyDuplicated(selected$gene),
    !any(selected$gene %in% exclude),
    all(diff(selected$evidence_score) <= 0),
    identical(
      selected$gene,
      head(eligible_ranked$gene, cfg$target_size)
    )
  )

  msg(
    "%s: %d candidates; %d excluded; top %d selected.",
    label,
    nrow(df),
    sum(all_ranked$excluded_by_other_signature),
    n_take
  )

  list(
    genes = selected$gene,
    table = selected,
    all_ranked = all_ranked,
    eligible_ranked = eligible_ranked,
    diagnostics = diagnostics
  )
}

