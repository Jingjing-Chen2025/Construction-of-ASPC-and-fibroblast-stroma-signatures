report_masking <- function(fns = c("select", "filter", "mutate", "arrange",
                                   "rename", "slice", "lag", "cor", "sd",
                                   "dist", "combine", "count", "first")) {
  found <- FALSE
  for (f in fns) {
    where <- utils::getAnywhere(f)
    pkgs <- unique(where$where[grepl("^package:", where$where)])
    pkgs <- sub("^package:", "", pkgs)
    if (length(pkgs) > 1) {
      found <- TRUE
      cat(sprintf("  %-10s resolved from '%s'  (also in: %s)\n",
                  f, pkgs[1], paste(pkgs[-1], collapse = ", ")))
    }
  }
  if (!found) msg("  No masking detected among the verbs this script uses.")
  else msg("  All dplyr verbs below are namespace-qualified, so masking is harmless.")
}
report_masking()

