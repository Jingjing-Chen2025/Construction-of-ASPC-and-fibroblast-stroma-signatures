} else {
  if (!has_seurat) stop("Seurat package is required to load scRNA reference for tau.")
  suppressPackageStartupMessages(library(Seurat))

  ref_obj <- readRDS(cfg$scrna_reference_rds)
  if (!inherits(ref_obj, "Seurat")) stop("scRNA reference RDS must be a Seurat object.")

  assay_use <- if ("RNA" %in% names(ref_obj@assays)) "RNA" else Seurat::DefaultAssay(ref_obj)
  Seurat::DefaultAssay(ref_obj) <- assay_use

  get_mat_try <- function(...) {
    tryCatch(as.matrix(Seurat::GetAssayData(ref_obj, assay = assay_use, ...)), error = function(e) NULL)
  }

  mat <- get_mat_try(slot = "data")
  if (is.null(mat) || nrow(mat) == 0) mat <- get_mat_try(slot = "counts")
  if (is.null(mat) || nrow(mat) == 0) mat <- get_mat_try(layer = "data")
  if (is.null(mat) || nrow(mat) == 0) mat <- get_mat_try(layer = "counts")
  if (is.null(mat) || nrow(mat) == 0) mat <- get_mat_try(layer = "scale.data")

  if (is.null(mat) || nrow(mat) == 0) stop("Failed to extract expression matrix from scRNA reference.")
  scrna_ref_mat <- mat

  md <- ref_obj@meta.data
  if ("seurat_clusters" %in% colnames(md)) {
    cl <- as.character(md$seurat_clusters)
    names(cl) <- rownames(md)
  } else {
    id <- Seurat::Idents(ref_obj)
    cl <- as.character(id)
    names(cl) <- names(id)
  }
  scrna_clusters <- cl[colnames(scrna_ref_mat)]
}

compute_tau <- function(mat, clusters, target_labels){
  if (is.null(mat) || is.null(clusters)) return(NULL)

  if (!is.null(names(clusters))) clusters <- clusters[colnames(mat)]
  keep <- !is.na(clusters)
  if (sum(keep) == 0) return(NULL)

  mat <- mat[, keep, drop = FALSE]
  clusters <- clusters[keep]

  cluster_levels <- unique(clusters)
  target_cols <- which(cluster_levels %in% target_labels)
  if (!length(target_cols)) return(NULL)

  pb <- sapply(cluster_levels, function(cl){
    cells <- names(clusters)[clusters == cl]
    rowMeans(mat[, cells, drop = FALSE], na.rm = TRUE)
  })
  rownames(pb) <- rownames(mat)

  tau_vec <- apply(pb, 1, function(x){
    mx <- max(x)
    if (mx <= 0) return(0)
    (sum(1 - (x / mx))) / (length(x) - 1)
  })

  target_expr <- apply(pb[, target_cols, drop = FALSE], 1, mean)
  other_expr  <- apply(pb[, -target_cols, drop = FALSE], 1, max)
  spec_ratio  <- ifelse(other_expr > 0, target_expr / other_expr, Inf)

  tibble(gene = toupper(rownames(pb)), tau = tau_vec, aspc_specific_ratio = spec_ratio)
}

