report_channels <- function(df, label) {
  cat(sprintf("\n--- Evidence channel activity: %s ---\n", label))
  n_row <- nrow(df)
  cat("  MEASURED EVIDENCE\n")
  for (cn in c(EVIDENCE_CHANNELS, NA, ANNOTATION_CHANNELS)) {
    if (is.na(cn)) { cat("  ANNOTATION\n"); next }
    n <- if (cn %in% names(df)) sum(df[[cn]], na.rm = TRUE) else 0L
    pct <- if (n_row > 0) 100 * n / n_row else 0
    flag <- if (n == 0) "  <-- CONTRIBUTES NOTHING"
            else if (pct > 100 * cfg$channel_saturation_warn) "  <-- fires for >90%, non-discriminating"
            else ""
    cat(sprintf("    %-22s weight %4.1f   TRUE %5d (%5.1f%%)%s\n", cn, w[[cn]], n, pct, flag))
  }
  if ("surface_species" %in% names(df)) {
    ss <- table(df$surface_species, useNA = "no")
    if (length(ss)) {
      cat("    surface source split: ",
          paste(sprintf("%s %d", names(ss), as.integer(ss)), collapse = " | "), "\n", sep = "")
    }
  }
  med_af <- stats::median(df$annotation_fraction, na.rm = TRUE)
  cat(sprintf("\n  median annotation share of evidence_score: %.0f%%\n", 100 * med_af))
  if (!is.na(med_af) && med_af > 0.5) {
    warn_msg("  For the median gene, MOST of the score comes from annotation")
    warn_msg("  rather than from measurement in this dataset.")
  }
  n_anno_only <- sum(df$evidence_only_score == 0 & df$annotation_score > 0, na.rm = TRUE)
  if (n_anno_only) {
    cat(sprintf("  %d genes have ZERO measured evidence but a non-zero score\n", n_anno_only))
    cat("    purely from annotation. They can still clear score gates.\n")
  }
}
