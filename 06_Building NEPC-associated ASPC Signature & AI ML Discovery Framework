        ratio_nepc_mean,
        cor_NEPC,
        cor_AR,
        candidate_rank,
        passes_adaptive_filter,
        eligible_rank,
        signature_rank,
        selected,
        forced_inclusion,
        selection_status
      ),
    by = "gene"
  ) %>%
  dplyr::left_join(
    aspc_sel$forced %>%
      dplyr::select(gene, displaced_gene, forced_outcome = outcome),
    by = "gene"
  ) %>%
  dplyr::mutate(
    selected = dplyr::coalesce(selected, FALSE),
    forced_inclusion = dplyr::coalesce(forced_inclusion, FALSE),
    selection_status = dplyr::if_else(
      !measured_in_bulk,
      "not_measured_in_bulk",
      selection_status
    )
  )

