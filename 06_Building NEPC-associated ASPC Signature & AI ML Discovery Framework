TAU_CANDIDATES <- c("tau", "tau_median", "tau_mean", "tau_max")

read_tau_column <- function(path, out_name, label) {
  df <- read_req(path, label, required = FALSE)
  if (is.null(df)) return(NULL)
  if (!"gene" %in% names(df)) {
    warn_msg("  %s has no 'gene' column; ignoring.", label)
    return(NULL)
  }
  msg("  %s columns: %s", label, paste(names(df), collapse = ", "))
  out <- pick_column(df, TAU_CANDIDATES, out_name, label)
  if (is.null(out)) return(NULL)

  if ("n_datasets" %in% names(df)) {
    nd <- tibble::tibble(gene = toupper(as.character(df$gene)),
                         v = suppressWarnings(as.numeric(df$n_datasets)))
    names(nd)[2] <- paste0(out_name, "_n_datasets")
    out <- dplyr::left_join(out, nd, by = "gene")
  }
  collapse_to_unique_gene(out)
}

