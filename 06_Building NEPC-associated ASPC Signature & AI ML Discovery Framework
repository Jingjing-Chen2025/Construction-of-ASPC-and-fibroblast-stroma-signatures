msg("FIBROBLAST_STROMA_SIGNATURE size: %d", length(FIBROBLAST_STROMA_SIGNATURE))
msg("TF flag TRUE count (evidence_df): %d", sum(evidence_df$is_TF_Cof_Chromatin, na.rm = TRUE))
msg("TF flag TRUE count (evidence_down_df): %d", sum(evidence_down_df$is_TF_Cof_Chromatin, na.rm = TRUE))
