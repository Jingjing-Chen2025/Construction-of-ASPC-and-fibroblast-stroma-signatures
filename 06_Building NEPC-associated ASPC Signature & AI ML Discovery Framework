load_cov <- function(path, needed){
  if (!file.exists(path)) {
    warn_msg("Missing %s; substituting zeros.", path)
    return(tibble())
  }
  df <- suppressMessages(readr::read_csv(path, show_col_types = FALSE))
  miss <- setdiff(needed, names(df))
  if (length(miss)) warn_msg("File %s missing columns: %s", path, paste(miss, collapse = ","))
  df
}

