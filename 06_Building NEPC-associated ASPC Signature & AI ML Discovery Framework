residualize_gene <- function(exp_vec, cov_df){
  df <- cov_df
  df$y <- as.numeric(exp_vec)

  for (nm in names(df)) {
    if (nm != "y" && any(is.na(df[[nm]]))) {
      df[[nm]][is.na(df[[nm]])] <- median(df[[nm]], na.rm = TRUE)
    }
  }

  fit <- try(lm(y ~ purity + ASPC_fraction + immune_fraction + stromal_fraction, data = df),
             silent = TRUE)
  if (inherits(fit, "try-error")) return(scale(df$y, center = TRUE, scale = TRUE)[, 1])
  resid(fit)
}

