get_candidates <- function(df, label) {
  if (is.null(df) || !all(c("gene", "n_datasets") %in% names(df))) {
    warn_msg("%s unusable; no candidates from this source.", label)
    return(character(0))
  }
  # report the pool at several recurrence levels — the ceiling on signature size
  for (k in 1:4) {
    msg("  %s: n_datasets >= %d -> %d genes", label, k, sum(df$n_datasets >= k, na.rm = TRUE))
  }
  g <- df %>%
    dplyr::filter(n_datasets >= cfg$min_marker_cohorts) %>%
    dplyr::pull(gene) %>% toupper() %>% unique() %>% sort()
  msg("%s: using %d candidates (min_marker_cohorts = %d)",
      label, length(g), cfg$min_marker_cohorts)
  g
}

