# v6: show the tau distribution so the ladder's tiers are interpretable
show_tau_dist <- function(v, label) {
  v <- v[!is.na(v)]
  if (!length(v)) {
    warn_msg("  %s: no values.", label)
    return(invisible(NULL))
  }
  qs <- stats::quantile(v, c(0.50, 0.75, 0.90, 0.95, 0.99), na.rm = TRUE)
  msg("  %s quantiles: 50%%=%.3f 75%%=%.3f 90%%=%.3f 95%%=%.3f 99%%=%.3f",
      label, qs[1], qs[2], qs[3], qs[4], qs[5])
  for (th in c(0.95, 0.90, 0.85, 0.80, 0.70, 0.60, 0.50)) {
    cat(sprintf("      >= %.2f : %6d genes\n", th, sum(v >= th)))
  }
}
