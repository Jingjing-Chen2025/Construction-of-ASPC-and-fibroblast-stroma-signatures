channel_activity <- function(df, branch) {
  tibble::tibble(
    branch = branch,
    channel = names(w),
    category = ifelse(
      names(w) %in% EVIDENCE_CHANNELS,
      "measured_evidence",
      "annotation"
    ),
    weight = unname(w),
    n_candidates = nrow(df),
    n_true = vapply(
      names(w),
      function(nm) sum(df[[nm]], na.rm = TRUE),
      integer(1)
    )
  ) %>%
    dplyr::mutate(
      fraction_true = if (nrow(df)) n_true / nrow(df) else NA_real_,
      saturation_warning =
        !is.na(fraction_true) &
        fraction_true >= cfg$channel_saturation_warn
    )
}

