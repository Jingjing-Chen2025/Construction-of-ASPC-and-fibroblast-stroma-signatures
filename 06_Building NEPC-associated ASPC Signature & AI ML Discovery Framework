cov_vec <- function(tbl, col){
  if (!nrow(tbl) || !col %in% names(tbl)) return(setNames(rep(0, length(samples)), samples))
  v <- tbl[[col]]; names(v) <- as.character(tbl$sample)
  n_hit <- sum(samples %in% names(v))
  if (n_hit == 0) {
    warn_msg("  %s: ZERO of %d expression samples matched. Example IDs —", col, length(samples))
    warn_msg("    expression: %s", paste(utils::head(samples, 3), collapse = ", "))
    warn_msg("    covariate : %s", paste(utils::head(names(v), 3), collapse = ", "))
  } else if (n_hit < length(samples)) {
    msg("  %s: matched %d of %d samples", col, n_hit, length(samples))
  }
  out <- v[samples]; out[is.na(out)] <- 0
  setNames(as.numeric(out), samples)
}

