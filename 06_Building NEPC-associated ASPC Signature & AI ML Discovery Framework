apply_tier <- function(df, tier, tau_col, ratio_col, direction) {
  keep <- rep(TRUE, nrow(df))
  tau_thr <- max(tier$tau, cfg$tau_floor)
  tv <- df[[tau_col]]
  keep <- keep & !is.na(tv) & tv >= tau_thr
  keep <- keep & !is.na(df$evidence_score) &
          df$evidence_score >= max(tier$score, cfg$score_floor)
  ratio_thr <- max(tier$ratio, cfg$ratio_floor)
  rv <- df[[ratio_col]]
  keep <- keep & !is.na(rv) & rv >= ratio_thr
  if (isTRUE(tier$require_cor)) keep <- keep & !is.na(df$cor_NEPC) & !is.na(df$cor_AR)
  if (isTRUE(tier$cor_gates)) {
    if (direction == "up") {
      keep <- keep & !is.na(df$cor_NEPC) & df$cor_NEPC >= cfg$cor_NEPC_min &
                     !is.na(df$cor_AR)   & df$cor_AR   <= cfg$cor_AR_max
    } else {
      keep <- keep & !is.na(df$cor_NEPC) & df$cor_NEPC <= cfg$cor_NEPC_down_max &
                     !is.na(df$cor_AR)   & df$cor_AR   >= cfg$cor_AR_down_min
    }
  }
  df[keep, , drop = FALSE]
}

rank_within <- function(df, tau_col, ratio_col, score_col = "evidence_score") {
  df %>%
    dplyr::arrange(
      dplyr::desc(.data[[score_col]]),
      dplyr::desc(dplyr::coalesce(.data[[ratio_col]], 0)),
      dplyr::desc(dplyr::coalesce(.data[[tau_col]],   0)),
      dplyr::desc(abs(dplyr::coalesce(partial_corr, 0)))
    )
}

select_signature <- function(df, label, tau_col, ratio_col, direction,
                             exclude = character(0)) {
  if (length(exclude)) df <- df %>% dplyr::filter(!(gene %in% exclude))

  tiers <- build_tiers()
  if (identical(cfg$selection_mode, "strict")) tiers <- tiers[1]
  if (identical(cfg$selection_mode, "rank_only")) tiers <- tiers[length(tiers)]

  trace <- list(); chosen <- NULL; chosen_tier <- NULL

  for (tr in tiers) {
    sub <- apply_tier(df, tr, tau_col, ratio_col, direction)
    trace[[length(trace) + 1]] <- tibble::tibble(
      branch = label, tier = tr$id, tier_label = tr$label,
      tau_thr = max(tr$tau, cfg$tau_floor),
      ratio_thr = max(tr$ratio, cfg$ratio_floor),
      score_thr = max(tr$score, cfg$score_floor),
      cor_gates = tr$cor_gates, require_cor = tr$require_cor,
      n_eligible = nrow(sub))
    cat(sprintf("  tier %d  %-42s eligible = %5d\n", tr$id, tr$label, nrow(sub)))
    if (is.null(chosen) || nrow(sub) > nrow(chosen)) { chosen <- sub; chosen_tier <- tr }
    if (nrow(sub) >= cfg$target_size) { chosen <- sub; chosen_tier <- tr; break }
  }

  trace_df <- dplyr::bind_rows(trace)

  if (is.null(chosen) || !nrow(chosen)) {
    warn_msg("%s: no gene passes even the loosest tier.", label)
    return(list(genes = character(0), tier = chosen_tier, trace = trace_df, table = chosen))
  }

  ranked <- rank_within(chosen, tau_col, ratio_col)
  n_take <- min(cfg$target_size, nrow(ranked))
  out <- utils::head(ranked, n_take)

  msg("%s: tier %d ('%s') -> %d eligible, taking top %d",
      label, chosen_tier$id, chosen_tier$label, nrow(chosen), n_take)
  msg("  effective thresholds: tau >= %.2f | ratio >= %.2f | score >= %.1f | cor gates %s",
      max(chosen_tier$tau, cfg$tau_floor), max(chosen_tier$ratio, cfg$ratio_floor),
      max(chosen_tier$score, cfg$score_floor), ifelse(chosen_tier$cor_gates, "ON", "OFF"))

  msg("  surface %d | secreted %d | ligand %d | ECM %d | TF %d  (of %d)",
      sum(out$is_surface, na.rm = TRUE), sum(out$is_secreted, na.rm = TRUE),
      sum(out$is_ligand, na.rm = TRUE), sum(out$is_ecm, na.rm = TRUE),
      sum(out$is_TF_Cof_Chromatin, na.rm = TRUE), nrow(out))

  # ---- v7: did the weight CREATE the surface content, or reveal it? ----
  if (isTRUE(cfg$surface_audit)) {
    alt <- utils::head(rank_within(chosen, tau_col, ratio_col, "evidence_only_score"), n_take)
    n_w  <- sum(out$is_surface, na.rm = TRUE)
    n_nw <- sum(alt$is_surface, na.rm = TRUE)
    msg("  SURFACE AUDIT: %d surface genes with the weight | %d ranking on measured",
        n_w, n_nw)
    msg("    evidence alone (%d genes differ between the two lists).",
        length(setdiff(out$gene, alt$gene)))
    if (n_w > 2 * max(n_nw, 1)) {
      warn_msg("    The is_surface weight (%.1f) is largely CREATING the surface",
               w$is_surface)
      warn_msg("    content rather than revealing it. If you cite surface-marker")
      warn_msg("    enrichment as evidence for cell identity, cite the")
      warn_msg("    evidence-only number, not this one.")
    }
  }

  if (n_take < cfg$target_size) {
    warn_msg("  Only %d genes available (target %d). The candidate pool or the",
             n_take, cfg$target_size)
    warn_msg("  floors (tau >= %.2f, ratio >= %.2f) are the binding constraint.",
             cfg$tau_floor, cfg$ratio_floor)
  }
  if (chosen_tier$id >= 6) {
    warn_msg("  Tier %d drops the correlation gates. Describe this signature as", chosen_tier$id)
    warn_msg("  'top %d by evidence among genes with tau >= %.2f', not as", n_take,
             max(chosen_tier$tau, cfg$tau_floor))
    warn_msg("  'genes with high cell-type specificity'.")
  }

  list(genes = unique(out$gene), tier = chosen_tier, trace = trace_df, table = out)
}

