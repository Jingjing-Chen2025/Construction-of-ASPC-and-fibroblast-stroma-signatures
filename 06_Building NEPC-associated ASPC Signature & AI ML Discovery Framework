standardize_marker_df <- function(df){
  if (is.null(df)) return(NULL)
  names(df) <- safe_make_names(names(df))

  ren <- function(pat, new){
    hit <- grep(pat, names(df), ignore.case = TRUE, value = TRUE)
    if (length(hit) == 1) names(df)[names(df) == hit] <<- new
  }

  ren("^gene$|^symbol$|^feature$", "gene")
  ren("^cluster$|^seurat_clusters$|^ident$|^cluster_id$", "cluster")
  ren("^avg_log2fc$|^avg_logfc$|^log2fc$|^logfc$", "avg_log2FC")
  ren("^p_val_adj$|^padj$|^fdr$", "p_val_adj")
  ren("^p_val$|^pvalue$", "p_val")
  ren("^pct\\.1$|^pct_1$|^percent\\.1$", "pct.1")
  ren("^pct\\.2$|^pct_2$|^percent\\.2$", "pct.2")

  df$cluster <- gsub("^c", "", as.character(df$cluster))
  suppressWarnings({
    num <- as.numeric(df$cluster)
    if (sum(!is.na(num)) == length(df$cluster)) df$cluster <- num
  })
  df
}

load_marker_source <- function(src){
  if (src$type == "csv") {
    if (!file.exists(src$file)) { warn_msg("Missing CSV: %s", src$file); return(NULL) }
    df <- tryCatch(read.csv(src$file, check.names = FALSE), error = function(e) NULL)
  } else {
    if (!file.exists(src$file)) { warn_msg("Missing Excel: %s", src$file); return(NULL) }
    df <- tryCatch(readxl::read_xlsx(src$file, sheet = src$sheet), error = function(e) NULL)
  }
  df <- standardize_marker_df(df)
  if (is.null(df)) return(NULL)
  df %>% dplyr::filter(as.character(cluster) == as.character(!!src$cluster))
}

filter_by_criteria <- function(df, log2fc_thr, fdr_thr, prev_thr){
  if (is.null(df) || !"gene" %in% names(df)) return(character(0))
  df <- df %>% mutate(gene = toupper(gene))
  if ("avg_log2FC" %in% names(df)) df <- df %>% filter(!is.na(avg_log2FC), avg_log2FC >= log2fc_thr)
  if ("p_val_adj" %in% names(df)) df <- df %>% filter(!is.na(p_val_adj), p_val_adj < fdr_thr)
  if (all(c("pct.1","pct.2") %in% names(df))) {
    df <- df %>% filter(!is.na(pct.1), !is.na(pct.2), pct.1 >= prev_thr, pct.2 <= (1 - prev_thr))
  }
  unique(df$gene)
}

