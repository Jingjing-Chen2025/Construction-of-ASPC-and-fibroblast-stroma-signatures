read_req <- function(path, label, required = TRUE) {
  if (!file.exists(path)) {
    if (required) {
      stop(label, " not found:\n  ", path,
           "\n  -> run the upstream script that produces it.")
    }
    warn_msg("%s not found (optional): %s", label, path)
    return(NULL)
  }
  msg("  %-28s %s", label, basename(path))
  readr::read_csv(path, show_col_types = FALSE)
}

collapse_to_unique_gene <- function(df) {
  if (is.null(df) || nrow(df) == 0) return(df)
  df <- tibble::as_tibble(df)
  if (!"gene" %in% names(df)) return(df)
  df <- df %>%
    dplyr::mutate(gene = toupper(as.character(gene))) %>%
    dplyr::filter(!is.na(gene) & gene != "")
  if (!any(duplicated(df$gene))) return(df)
  suppressWarnings(
    df %>%
      dplyr::group_by(gene) %>%
      dplyr::summarise(
        dplyr::across(dplyr::where(is.logical),   ~ any(.x, na.rm = TRUE)),
        dplyr::across(dplyr::where(is.numeric),   ~ max(.x, na.rm = TRUE)),
        dplyr::across(dplyr::where(is.character), ~ dplyr::first(stats::na.omit(.x))),
        .groups = "drop") %>%
      dplyr::mutate(dplyr::across(dplyr::where(is.numeric),
                                  ~ ifelse(is.finite(.x), .x, NA_real_)))
  )
}

empty_tibble_with_cols <- function(cols, n = 0) {
  out <- lapply(cols, function(cn) if (cn == "gene") character(n) else numeric(n))
  names(out) <- cols
  tibble::as_tibble(out)
}

ensure_joinable <- function(obj, cols = c("gene")) {
  if (is.null(obj)) return(empty_tibble_with_cols(cols, n = 0))
  if (is.vector(obj) && is.character(obj)) obj <- tibble::tibble(gene = obj)
  df <- tibble::as_tibble(obj)
  if (!"gene" %in% names(df)) df$gene <- character(nrow(df))
  df$gene <- as.character(df$gene)
  missing_cols <- setdiff(cols, names(df))
  if (length(missing_cols)) {
    df <- dplyr::bind_cols(df, empty_tibble_with_cols(missing_cols, n = nrow(df)))
  }
  df %>% dplyr::select(dplyr::all_of(cols))
}

pick_column <- function(df, candidates, out_name, label) {
  hit <- intersect(candidates, names(df))
  if (!length(hit)) {
    warn_msg("  %s: none of [%s] present. Columns are: %s",
             label, paste(candidates, collapse = ", "),
             paste(names(df), collapse = ", "))
    return(NULL)
  }
  if (length(hit) > 1) {
    msg("  %s: using '%s' (also saw %s)", label, hit[1], paste(hit[-1], collapse = ", "))
  }
  out <- tibble::tibble(gene = toupper(as.character(df$gene)),
                        v = suppressWarnings(as.numeric(df[[hit[1]]])))
  names(out)[2] <- out_name
  out %>% dplyr::filter(!is.na(gene), gene != "")
}

