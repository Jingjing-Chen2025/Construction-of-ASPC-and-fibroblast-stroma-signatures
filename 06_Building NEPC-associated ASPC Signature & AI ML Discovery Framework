score_from_genes <- function(gset, expr_mat) {
  gset <- intersect(toupper(gset), rownames(expr_mat))
  if (!length(gset)) return(rep(NA_real_, ncol(expr_mat)))
  z <- zscale_cols(expr_mat[gset, , drop = FALSE])
  colMeans(z, na.rm = TRUE)
}

