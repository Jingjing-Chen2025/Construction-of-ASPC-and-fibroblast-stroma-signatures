RATIO_CANDIDATES <- c("aspc_specific_ratio", "ratio_mean", "ratio_median", "ratio_max")

read_ratio_pooled <- function(path, prefix, label) {
  df <- read_req(path, label, required = FALSE)
  if (is.null(df) || !"gene" %in% names(df)) return(NULL)
  msg("  %s columns: %s", label, paste(names(df), collapse = ", "))

  base <- pick_column(df, RATIO_CANDIDATES, paste0(prefix, "_mean"), label)
  if (is.null(base)) return(NULL)

  gene_uc <- toupper(as.character(df$gene))
  add_num <- function(tbl, src_col, new_col) {
    if (!src_col %in% names(df)) return(tbl)
    x <- tibble::tibble(gene = gene_uc, v = suppressWarnings(as.numeric(df[[src_col]])))
    names(x)[2] <- new_col
    dplyr::left_join(tbl, x, by = "gene")
  }
  base <- base %>%
    add_num("ratio_max",            paste0(prefix, "_max")) %>%
    add_num("aspc_specific_ratio",  paste0(prefix, "_median")) %>%
    add_num("n_datasets",           paste0(prefix, "_n_datasets")) %>%
    add_num("n_datasets_ratio_gt2", paste0(prefix, "_n_high"))

  collapse_to_unique_gene(base)
}

read_ratio_long <- function(path, prefix, thr) {
  if (!file.exists(path)) {
    warn_msg("Long ratio table absent: %s", basename(path))
    return(NULL)
  }
  df <- readr::read_csv(path, show_col_types = FALSE)
  if (!all(c("gene", "aspc_specific_ratio", "dataset") %in% names(df))) return(NULL)
  df %>%
    dplyr::mutate(gene = toupper(gene)) %>%
    dplyr::group_by(gene) %>%
    dplyr::summarise("{prefix}_present_frac" := mean(aspc_specific_ratio > thr, na.rm = TRUE),
                     .groups = "drop")
}

