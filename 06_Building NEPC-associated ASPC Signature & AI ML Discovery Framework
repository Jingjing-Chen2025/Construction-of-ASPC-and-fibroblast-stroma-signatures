get_candidates <- function(df, label) {
  if (is.null(df) || !all(c("gene","n_datasets") %in% names(df))) {
    warn_msg("%s unusable; no candidates from this source.", label)
    return(character(0))
  }
  n_coh <- max(df$n_datasets, na.rm = TRUE)
  for (k in seq_len(min(n_coh, 6))) {
    msg("  %s: n_datasets >= %d of %d -> %d genes", label, k, n_coh,
        sum(df$n_datasets >= k, na.rm = TRUE))
  }
  g <- df %>%
    dplyr::filter(n_datasets >= cfg$min_marker_cohorts) %>%
    dplyr::pull(gene) %>% toupper() %>% unique() %>% sort()
  msg("%s: using %d candidates (min_marker_cohorts = %d)", label, length(g),
      cfg$min_marker_cohorts)
  if (cfg$min_marker_cohorts == 1) {
    warn_msg("  min_marker_cohorts = 1 means a gene need appear in only ONE")
    warn_msg("  cohort's top-200. That is not cross-cohort replication.")
  }
  g
}

