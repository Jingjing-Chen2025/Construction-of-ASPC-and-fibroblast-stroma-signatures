  ) %>%
  arrange(
    desc(evidence_score),
    desc(ratio_adeno_mean),
    desc(high_tau),
    desc(high_partial_corr),
    desc(abs(partial_corr)),
    desc(abs(cor_NEPC))
  ) %>%
  pull(gene) %>%
  unique()

# -----------------------------
# ASPC_UP selection -> ASPC_SIGNATURE
# -----------------------------
ASPC_SIGNATURE <- evidence_df %>%
  filter(
    high_tau,
    evidence_score >= score_threshold,
    !is.na(cor_NEPC),
    !is.na(cor_AR),
    cor_NEPC  >= cfg$cor_NEPC_min,
    cor_AR    <= cfg$cor_AR_max,
    !is.na(ratio_nepc_mean),
    ratio_nepc_mean >= cfg$ratio_nepc_mean_threshold,
    !(gene %in% FIBROBLAST_STROMA_SIGNATURE)
  ) %>%
  arrange(
    desc(evidence_score),
    desc(ratio_nepc_mean),
    desc(high_tau),
    desc(high_partial_corr),
    desc(abs(partial_corr)),
    desc(abs(cor_NEPC))
  ) %>%
  pull(gene) %>%
  unique()

# -----------------------------
# Output per-sample signature scores
# -----------------------------
ASPC_bulk_score <- score_from_genes(ASPC_SIGNATURE, expr_mat)
FIBROBLAST_STROMA_bulk_score <- score_from_genes(FIBROBLAST_STROMA_SIGNATURE, expr_mat)

bulk_signature_scores_tbl <- tibble(
  sample = colnames(expr_mat),
  NEPC_score = as.numeric(NEPC_score[colnames(expr_mat)]),
  AR_score = as.numeric(AR_score[colnames(expr_mat)]),
  ASPC_signature_score = as.numeric(ASPC_bulk_score[colnames(expr_mat)]),
  FIBROBLAST_STROMA_signature_score = as.numeric(FIBROBLAST_STROMA_bulk_score[colnames(expr_mat)])
)

write_csv(
  bulk_signature_scores_tbl,
  file.path(cfg$results_dir, "bulk_signature_scores_NEPC_AR_ASPC_up_down.csv")
)

msg("Wrote bulk signature scores: %s",
    file.path(cfg$results_dir, "bulk_signature_scores_NEPC_AR_ASPC_up_down.csv"))

# -----------------------------
# Outputs
# -----------------------------
writeLines(ASPC_SIGNATURE,              file.path(cfg$results_dir, "ASPC_SIGNATURE.txt"))
writeLines(FIBROBLAST_STROMA_SIGNATURE, file.path(cfg$results_dir, "FIBROBLAST_STROMA_SIGNATURE.txt"))

write_csv(evidence_df,      file.path(cfg$results_dir, "evidence_matrix_ASPC_UP.csv"))
write_csv(evidence_down_df, file.path(cfg$results_dir, "evidence_matrix_ASPC_DOWN.csv"))

