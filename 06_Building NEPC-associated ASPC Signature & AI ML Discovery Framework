hdr("STEP 8 — weighted evidence matrices")

sum_channels <- function(df, channels) {
  out <- numeric(nrow(df))
  for (channel in channels) {
    out <- out + unname(w[channel]) * as.integer(df[[channel]])
  }
  out
}

build_evidence <- function(
    candidates,
    marker_candidates,
    extra_candidates,
    branch,
    tau_col,
    ratio_col,
    ratio_threshold) {

  df <- tibble::tibble(
    gene = sort(intersect(candidates, rownames(expr_mat)))
  ) %>%
    dplyr::left_join(sc_tbl, by = "gene") %>%
    dplyr::left_join(bulk_evidence_tbl, by = "gene") %>%
    dplyr::left_join(multi_task_tbl, by = "gene") %>%
    dplyr::left_join(stability_tbl, by = "gene") %>%
    dplyr::left_join(wgcna_tbl, by = "gene") %>%
    dplyr::mutate(
      branch = .env$branch,
      in_recurrence_candidate_pool = gene %in% marker_candidates,
      extra_candidate = gene %in% clean_genes(extra_candidates),

      tau_used = .data[[tau_col]],
      ratio_used = .data[[ratio_col]],

      high_tau =
        is.finite(tau_used) &
        tau_used >= cfg$tau_threshold,

      high_partial_corr =
        is.finite(partial_corr) &
        partial_corr >= cfg$partial_corr_threshold,

      atlas_supported =
        is.finite(tau_used) &
        tau_used >= cfg$tau_threshold &
        is.finite(ratio_used) &
        ratio_used >= ratio_threshold,

      # Record availability before replacing missing flags with FALSE.
      multi_task_flag_available = !is.na(multi_task_positive),
      stability_flag_available = !is.na(stability_selected),
      wgcna_flag_available = !is.na(in_wgcna_module),

      multi_task_positive =
        dplyr::coalesce(multi_task_positive, FALSE),
      stability_selected =
        dplyr::coalesce(stability_selected, FALSE),
      in_wgcna_module =
        dplyr::coalesce(in_wgcna_module, FALSE),
      in_any_module =
        dplyr::coalesce(in_any_module, FALSE),

      is_TF_Cof_Chromatin = gene %in% tf_cof_chromatin,
      is_ligand = gene %in% ligands | gene %in% LIGAND_OVERRIDE,
      is_secreted = gene %in% secreted,
      is_surface = gene %in% surfaceome,
      is_ecm = gene %in% matrisome,
      is_metabolic = gene %in% metabolic,

      surface_species = dplyr::case_when(
        gene %in% cspa_human & gene %in% cspa_mouse ~ "human+mouse",
        gene %in% cspa_human ~ "human",
        gene %in% cspa_mouse ~ "mouse",
        is_surface ~ "unspecified_cache_or_fallback",
        TRUE ~ NA_character_
      ),
      surface_source = .env$surface_source
    )

  df$evidence_only_score <- sum_channels(df, EVIDENCE_CHANNELS)
  df$annotation_score <- sum_channels(df, ANNOTATION_CHANNELS)
  df$evidence_score <- df$evidence_only_score + df$annotation_score

  df <- df %>%
    dplyr::mutate(
      annotation_fraction = dplyr::if_else(
        evidence_score > 0,
        annotation_score / evidence_score,
        NA_real_
      )
    )

  # Per-channel point contributions make each total directly auditable.
  for (channel in names(w)) {
    df[[paste0("points_", channel)]] <-
      unname(w[channel]) * as.integer(df[[channel]])
  }

  if (anyDuplicated(df$gene)) {
    stop("Duplicate genes remain in ", branch, " evidence matrix.")
  }
  if (any(!is.finite(df$evidence_score))) {
    stop("Non-finite evidence_score in ", branch, " evidence matrix.")
  }

  df
}

