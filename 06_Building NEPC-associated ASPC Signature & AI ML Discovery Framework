empty_tibble_with_cols <- function(cols, n = 0) {
  out <- lapply(cols, function(cn) if (cn == "gene") character(n) else numeric(n))
  names(out) <- cols
  tibble::as_tibble(out)
}

ensure_joinable <- function(obj, cols = c("gene")) {
  if (is.null(obj)) return(empty_tibble_with_cols(cols, n = 0))
  if (is.vector(obj) && is.character(obj)) return(tibble::tibble(gene = obj))
  df <- tibble::as_tibble(obj)
  if ("gene" %in% cols && !"gene" %in% names(df)) df$gene <- character(nrow(df))
  if ("gene" %in% names(df)) df$gene <- as.character(df$gene)
  missing_cols <- setdiff(cols, names(df))
  if (length(missing_cols)) df <- dplyr::bind_cols(df, empty_tibble_with_cols(missing_cols, n = nrow(df)))
  df[, unique(c(cols, names(df))), drop = FALSE]
}

