report_channels <- function(df, label) {
  cat(sprintf("\n--- Evidence channel activity: %s ---\n", label))
  ch <- c("high_tau","high_partial_corr","in_wgcna_module","multi_task_positive",
          "stability_selected","atlas_supported","is_ligand","is_secreted",
          "is_ecm","is_metabolic","is_TF_Cof_Chromatin")
  n_row <- nrow(df)
  for (cn in ch) {
    n <- if (cn %in% names(df)) sum(df[[cn]], na.rm = TRUE) else 0L
    pct <- if (n_row > 0) 100 * n / n_row else 0
    flag <- if (n == 0) {
      "  <-- CONTRIBUTES NOTHING"
    } else if (pct > 90) {
      "  <-- fires for >90%, non-discriminating"
    } else {
      ""
    }
    cat(sprintf("  %-22s weight %4.1f   TRUE %5d (%5.1f%%)%s\n", cn, w[[cn]], n, pct, flag))
  }
}
