load_cov <- function(path, needed){
  if (!file.exists(path)) {
    warn_msg("Missing %s; substituting zeros.", basename(path))
    return(tibble::tibble())
  }
  df <- suppressMessages(readr::read_csv(path, show_col_types = FALSE))
