      warn_msg("  PERMISSIVE v1 definition (any module), not ASPC-restricted.")
    } else wm$in_wgcna_module <- as.logical(wm$in_wgcna_module)

    if (!"in_any_module" %in% names(wm)) wm$in_any_module <- wm$in_wgcna_module

    keep_cols <- intersect(c("gene","kME","in_wgcna_module","in_any_module","module"), names(wm))
    wgcna_membership <- wm %>% dplyr::select(dplyr::all_of(keep_cols)) %>% collapse_to_unique_gene()

    n_aspc <- sum(wgcna_membership$in_wgcna_module, na.rm = TRUE)
    n_any  <- sum(wgcna_membership$in_any_module,  na.rm = TRUE)
    n_tot  <- nrow(wgcna_membership)
    msg("in_wgcna_module TRUE (ASPC module): %d genes", n_aspc)
    msg("in_any_module   TRUE (any module) : %d genes", n_any)

    frac <- if (n_tot > 0) n_aspc / n_tot else 0
    msg("ASPC module covers %.1f%% of the %d genes in the network.", 100 * frac, n_tot)
    if (frac > cfg$wgcna_max_frac) {
      warn_msg("Above cfg$wgcna_max_frac (%.0f%%). A module this large is usually",
               100 * cfg$wgcna_max_frac)
      warn_msg("the dominant variance axis, not an ASPC programme, so")
      warn_msg("w$in_wgcna_module (%.1f) fires for nearly every candidate.", w$in_wgcna_module)
      warn_msg("  Inspect: %s", file.path(wgcna_dir, "wgcna_module_summary.csv"))
    }
    ms_csv <- file.path(wgcna_dir, "wgcna_module_summary.csv")
    if (file.exists(ms_csv)) {
      ms <- suppressMessages(readr::read_csv(ms_csv, show_col_types = FALSE))
      if ("selection_mode" %in% names(ms)) {
        sm <- unique(stats::na.omit(ms$selection_mode))
        if (length(sm) && any(grepl("fallback", sm))) {
          warn_msg("05_ selected its ASPC module by FALLBACK, not significance.")
          warn_msg("  Treat w$in_wgcna_module (%.1f) as weak evidence.", w$in_wgcna_module)
        }
      }
    }
  } else warn_msg("WGCNA membership CSV not found in %s", wgcna_dir)
} else warn_msg("No WGCNA run directory found under %s", WGCNA_BASE)

