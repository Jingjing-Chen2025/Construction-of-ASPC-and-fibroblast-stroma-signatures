normalize_symbols <- function(x) {
  toupper(trimws(as.character(x)))
}

clean_genes <- function(x) {
  x <- normalize_symbols(x)
  sort(unique(x[
    !is.na(x) & nzchar(x) & !(x %in% c("NA", "-"))
  ]))
}

to_num <- function(x) {
  y <- suppressWarnings(as.numeric(as.character(x)))
  y[!is.finite(y)] <- NA_real_
  y
}

to_flag <- function(x) {
  y <- tolower(trimws(as.character(x)))
  out <- rep(NA, length(y))
  out[y %in% c("true", "t", "yes", "y", "1")] <- TRUE
  out[y %in% c("false", "f", "no", "n", "0")] <- FALSE
  out
}

max_finite <- function(x) {
  x <- to_num(x)
  if (!any(is.finite(x))) return(NA_real_)
  max(x, na.rm = TRUE)
}

first_nonmissing <- function(x) {
  x <- x[!is.na(x)]
  if (!length(x)) return(NA_character_)
  as.character(x[1])
}

collapse_genes <- function(df) {
  df <- tibble::as_tibble(df)

  if (!"gene" %in% names(df)) {
    stop("A gene table is missing its gene column.")
  }

  df <- df %>%
    dplyr::mutate(gene = normalize_symbols(gene)) %>%
    dplyr::filter(!is.na(gene), gene != "", gene != "NA")

  if (!anyDuplicated(df$gene)) return(df)

  warn_msg(
    "Collapsing %d duplicated gene rows.",
    sum(duplicated(df$gene))
  )

  df %>%
    dplyr::group_by(gene) %>%
    dplyr::summarise(
      dplyr::across(
        dplyr::where(is.logical),
        ~ any(.x, na.rm = TRUE)
      ),
      dplyr::across(
        dplyr::where(is.numeric),
        max_finite
      ),
      dplyr::across(
        dplyr::where(is.character),
        first_nonmissing
      ),
      .groups = "drop"
    )
}

read_csv_input <- function(path, label, required = FALSE) {
  if (!file.exists(path)) {
    if (required) stop(label, " not found: ", path)
    warn_msg("%s not found: %s", label, path)
    return(NULL)
  }

  out <- tryCatch(
    readr::read_csv(
      path,
      show_col_types = FALSE,
      progress = FALSE
    ),
    error = function(e) {
      if (required) stop(label, ": ", conditionMessage(e))
      warn_msg("%s unreadable: %s", label, conditionMessage(e))
      NULL
    }
  )

  if (!is.null(out)) {
    msg("%s: %d rows", label, nrow(out))
  }

  out
}

read_gene_list <- function(path, required = FALSE) {
  if (!file.exists(path)) {
    if (required) stop("Required annotation file missing: ", path)
    warn_msg("Optional annotation file missing: %s", path)
    return(character(0))
  }

  x <- readLines(path, warn = FALSE)

  if (any(grepl(
    "<html|</html|<script|aliyunwaf|acw_sc",
    head(x, 50),
    ignore.case = TRUE
  ))) {
    stop("Annotation file appears to contain HTML: ", path)
  }

  x <- clean_genes(x)

  if (required && !length(x)) {
    stop("Required annotation list is empty: ", path)
  }

  x
}

empty_numeric_table <- function(columns) {
  out <- tibble::tibble(gene = character())
  for (nm in columns) out[[nm]] <- numeric()
  out
}

pick_numeric_gene_column <- function(
    path, candidates, out_name, label) {
  df <- read_csv_input(path, label)
  empty <- empty_numeric_table(out_name)

  if (is.null(df) || !"gene" %in% names(df)) return(empty)

  hit <- candidates[candidates %in% names(df)]
  if (!length(hit)) {
    warn_msg("%s has no supported value column.", label)
    return(empty)
  }

  msg("%s: using '%s' as '%s'", label, hit[1], out_name)

  out <- tibble::tibble(
    gene = normalize_symbols(df$gene),
    value = to_num(df[[hit[1]]])
  )
  names(out)[2] <- out_name
  collapse_genes(out)
}

read_recurrence <- function(path, out_name, label) {
  df <- read_csv_input(path, label, required = TRUE)

  if (!all(c("gene", "n_datasets") %in% names(df))) {
    stop(label, " requires gene and n_datasets columns.")
  }

  out <- tibble::tibble(
    gene = normalize_symbols(df$gene),
    value = to_num(df$n_datasets)
  )
  names(out)[2] <- out_name
  collapse_genes(out)
}

read_ratio <- function(path, prefix, label) {
  df <- read_csv_input(path, label)

  cols <- paste0(
    prefix,
    c("_mean", "_median", "_max", "_n_datasets")
  )
  empty <- empty_numeric_table(cols)
  empty[[paste0(prefix, "_source_column")]] <- character()

  if (is.null(df) || !"gene" %in% names(df)) return(empty)

  # Preserve v7's column preference. With the checked-in 03_ output,
  # aspc_specific_ratio contains the across-cohort median.
  choices <- c(
    "target_specific_ratio",
    "aspc_specific_ratio",
    "ratio_mean",
    "ratio_median",
    "ratio_max"
  )
  hit <- choices[choices %in% names(df)]

  if (!length(hit)) {
    warn_msg("%s has no supported ratio column.", label)
    return(empty)
  }

  column_or_na <- function(nm) {
    if (nm %in% names(df)) to_num(df[[nm]])
    else rep(NA_real_, nrow(df))
  }

  median_choices <- c(
    "target_specific_ratio",
    "aspc_specific_ratio",
    "ratio_median"
  )
  median_hit <- median_choices[
    median_choices %in% names(df)
  ]

  out <- tibble::tibble(gene = normalize_symbols(df$gene))
  out[[paste0(prefix, "_mean")]] <- to_num(df[[hit[1]]])
  out[[paste0(prefix, "_median")]] <- if (length(median_hit)) {
    to_num(df[[median_hit[1]]])
  } else {
    rep(NA_real_, nrow(df))
  }
  out[[paste0(prefix, "_max")]] <- column_or_na("ratio_max")
  out[[paste0(prefix, "_n_datasets")]] <- column_or_na("n_datasets")
  out[[paste0(prefix, "_source_column")]] <- hit[1]

  msg(
    "%s: '%s' stored in %s_mean; name retained for compatibility.",
    label, hit[1], prefix
  )

  collapse_genes(out)
}

read_ratio_presence <- function(path, out_name) {
  df <- read_csv_input(path, basename(path))
  empty <- empty_numeric_table(out_name)

  if (is.null(df) ||
      !all(c("gene", "dataset") %in% names(df))) {
    return(empty)
  }

  hit <- c("target_specific_ratio", "aspc_specific_ratio")
  hit <- hit[hit %in% names(df)]
  if (!length(hit)) return(empty)

  out <- tibble::tibble(
    gene = normalize_symbols(df$gene),
    dataset = as.character(df$dataset),
    ratio = to_num(df[[hit[1]]])
  ) %>%
    dplyr::filter(!is.na(gene), gene != "") %>%
    dplyr::group_by(gene, dataset) %>%
    dplyr::summarise(
      ratio = max_finite(ratio),
      .groups = "drop"
    ) %>%
    dplyr::group_by(gene) %>%
    dplyr::summarise(
      value = if (all(is.na(ratio))) {
        NA_real_
      } else {
        mean(
          ratio > cfg$ratio_present_threshold,
          na.rm = TRUE
        )
      },
      .groups = "drop"
    )

  names(out)[2] <- out_name
  out
}

safe_cor <- function(x, y) {
  ok <- is.finite(x) & is.finite(y)
  if (sum(ok) < 3L) return(NA_real_)
  if (stats::sd(x[ok]) <= 1e-12 ||
      stats::sd(y[ok]) <= 1e-12) {
    return(NA_real_)
  }
  stats::cor(x[ok], y[ok], method = "pearson")
}

score_from_genes <- function(gset, mat) {
  gset <- intersect(clean_genes(gset), rownames(mat))
  empty <- setNames(rep(NA_real_, ncol(mat)), colnames(mat))
  if (!length(gset)) return(empty)

  x <- mat[gset, , drop = FALSE]
  z <- matrix(
    NA_real_,
    nrow = nrow(x),
    ncol = ncol(x),
    dimnames = dimnames(x)
  )

  for (i in seq_len(nrow(x))) {
    ok <- is.finite(x[i, ])
    if (sum(ok) < 2L) next
    s <- stats::sd(x[i, ok])
    if (!is.finite(s) || s <= 1e-12) next
    z[i, ok] <- (
      x[i, ok] - mean(x[i, ok])
    ) / s
  }

  out <- colMeans(z, na.rm = TRUE)
  out[!is.finite(out)] <- NA_real_
  setNames(out, colnames(mat))
}

