# -----------------------------
# PATCH: prevent many-to-many joins + memory blow-ups
# -----------------------------
collapse_to_unique_gene <- function(df) {
  if (is.null(df) || nrow(df) == 0) return(df)
  df <- tibble::as_tibble(df)
  if (!"gene" %in% names(df)) return(df)

  df <- df %>%
    dplyr::mutate(gene = toupper(as.character(gene))) %>%
    dplyr::filter(!is.na(gene) & gene != "")

  if (!any(duplicated(df$gene))) return(df)

  df %>%
    dplyr::group_by(gene) %>%
    dplyr::summarise(
      dplyr::across(where(is.logical), ~ any(.x, na.rm = TRUE)),
      dplyr::across(where(is.numeric), ~ suppressWarnings(max(.x, na.rm = TRUE))),
      dplyr::across(where(is.character), ~ dplyr::first(na.omit(.x))),
      .groups = "drop"
    )
}

maybe_collapse <- function(x) {
  if (exists(x, inherits = TRUE)) {
    assign(x, collapse_to_unique_gene(get(x, inherits = TRUE)), inherits = TRUE)
  }
}

