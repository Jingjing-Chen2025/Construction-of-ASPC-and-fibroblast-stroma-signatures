cov_vec <- function(tbl, col){
  if (!nrow(tbl) || !col %in% names(tbl)) {
    return(setNames(rep(0, length(samples)), samples))
  }
  v <- tbl[[col]]; names(v) <- tbl$sample
  out <- v[samples]; out[is.na(out)] <- 0
  setNames(as.numeric(out), samples)
}

