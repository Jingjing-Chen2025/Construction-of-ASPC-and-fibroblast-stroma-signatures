cor_with <- function(genes, trait_vec) {
  vapply(genes, function(g) {
    if (!g %in% rownames(expr_mat)) return(NA_real_)
    x <- expr_mat[g, ]
    if (stats::sd(x, na.rm = TRUE) == 0 || stats::sd(trait_vec, na.rm = TRUE) == 0) return(NA_real_)
    stats::cor(x, trait_vec, use = "pairwise.complete.obs")
  }, numeric(1))
