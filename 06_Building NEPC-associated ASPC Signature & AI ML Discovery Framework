partial_corr_one <- function(expression, fraction, cov_df) {
  # Preserve the distinction between adjusted and unadjusted correlation:
  # no usable adjustment variables -> no partial-correlation score channel.
  if (!ncol(cov_df)) return(NA_real_)

  ok <- is.finite(expression) & is.finite(fraction) &
    stats::complete.cases(cov_df)

  if (sum(ok) < 4L) return(NA_real_)

  design <- cbind(
    intercept = 1,
    as.matrix(cov_df[ok, , drop = FALSE])
  )
  qr_design <- qr(design)

  # Retain at least three residual dimensions.
  if (sum(ok) - qr_design$rank < 3L) return(NA_real_)

  expression_resid <- qr.resid(qr_design, expression[ok])
  fraction_resid <- qr.resid(qr_design, fraction[ok])

  safe_cor(expression_resid, fraction_resid)
}

