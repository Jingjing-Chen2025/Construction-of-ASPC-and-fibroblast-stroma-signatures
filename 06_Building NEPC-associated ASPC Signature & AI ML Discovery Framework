# normalise a column name for tolerant matching
norm_nm <- function(x) tolower(gsub("[^a-z0-9]+", " ", tolower(trimws(x))))

find_col <- function(df, candidates, what) {
  nms  <- names(df)
  norm <- norm_nm(nms)
  for (cand in candidates) {
    i <- which(norm == norm_nm(cand))
    if (length(i)) return(nms[i[1]])
  }
  # loose contains-match as a second pass
  key <- switch(what,
                symbol   = "symbol",
                category = "categ",
                uniprot  = "cell surface")
  i <- grep(key, norm, fixed = TRUE)
  if (length(i)) return(nms[i[1]])
  NA_character_
}

read_cspa_sheet <- function(path, sheet, species) {
  df <- tryCatch(readxl::read_excel(path, sheet = sheet),
                 error = function(e) { warn_msg("  Sheet '%s' unreadable: %s",
                                                sheet, conditionMessage(e)); NULL })
  if (is.null(df) || !nrow(df)) return(character(0))

  msg("  [%s] sheet '%s': %d rows x %d cols", species, sheet, nrow(df), ncol(df))
  msg("    columns: %s", paste(utils::head(names(df), 10), collapse = " | "))

  sym_col  <- find_col(df, cfg$cspa_symbol_cols,   "symbol")
  cat_col  <- find_col(df, cfg$cspa_category_cols, "category")
  uni_col  <- find_col(df, cfg$cspa_uniprot_cols,  "uniprot")

  if (is.na(sym_col)) {
    warn_msg("    No 'ENTREZ gene symbol' column found — sheet skipped.")
    return(character(0))
  }
  msg("    symbol column   : '%s'", sym_col)

  n0 <- nrow(df)

  # ---- CSPA category "1 - high confidence" ----
  if (isTRUE(cfg$cspa_require_category1)) {
    if (is.na(cat_col)) {
      warn_msg("    No 'CSPA category' column — category filter NOT applied.")
      warn_msg("      Categories 2-4 are lower-confidence identifications.")
    } else {
      msg("    category column : '%s'", cat_col)
      cv <- trimws(as.character(df[[cat_col]]))
      keep <- grepl("^1\\b", cv) | grepl("^1\\s*-", cv) |
              grepl("high\\s*confidence", cv, ignore.case = TRUE)
      msg("    CSPA category 1 : %d of %d rows", sum(keep, na.rm = TRUE), n0)
      df <- df[which(keep), , drop = FALSE]
    }
  }

  # ---- UniProt Cell surface == "yes" ----
  if (isTRUE(cfg$cspa_require_uniprot)) {
    if (is.na(uni_col)) {
      warn_msg("    No 'UniProt Cell surface' column — flag filter NOT applied.")
    } else {
      msg("    uniprot column  : '%s'", uni_col)
      uv <- tolower(trimws(as.character(df[[uni_col]])))
      before <- nrow(df)
      keep <- uv %in% c("yes", "y", "true", "1")
      msg("    UniProt surface = yes : %d of %d remaining rows",
          sum(keep, na.rm = TRUE), before)
      df <- df[which(keep), , drop = FALSE]
    }
  }

  if (!nrow(df)) {
    warn_msg("    No rows survive both filters on sheet '%s'.", sheet)
    return(character(0))
  }

  # CSPA rows can list several symbols separated by ; or ,
  x <- unlist(strsplit(as.character(df[[sym_col]]), "[;,]"))
  x <- toupper(trimws(x))
  x <- x[!is.na(x) & x != "" & x != "NA" & x != "-"]
  x <- unique(x)
  msg("    -> %d unique %s symbols", length(x), species)
  x
}

