branch_gate_pass <- function(df,
                             tau_col,
                             ratio_col,
                             tau_threshold,
                             ratio_threshold,
                             min_score,
                             directional_gates,
                             require_finite_cor,
                             cor_nepc_sign,
                             cor_ar_sign,
                             cor_ar_limit) {
  tau_used <- df[[tau_col]]
  ratio_used <- df[[ratio_col]]

  tau_ok <- is.finite(tau_used) & tau_used >= tau_threshold
  ratio_ok <- is.finite(ratio_used) & ratio_used >= ratio_threshold
  score_ok <- is.finite(df$evidence_score) & df$evidence_score >= min_score

  finite_cor_ok <- if (require_finite_cor) {
    is.finite(df$cor_NEPC) & is.finite(df$cor_AR)
  } else {
    rep(TRUE, nrow(df))
  }

  directional_ok <- if (directional_gates) {
    if (cor_nepc_sign == ">=" && cor_ar_sign == "<=") {
      df$cor_NEPC >= 0 & df$cor_AR <= cor_ar_limit
    } else if (cor_nepc_sign == "<=" && cor_ar_sign == ">=") {
      df$cor_NEPC <= 0 & df$cor_AR >= cor_ar_limit
    } else {
      stop("Unsupported correlation direction configuration.")
    }
  } else {
    rep(TRUE, nrow(df))
  }

  tau_ok & ratio_ok & score_ok & finite_cor_ok & directional_ok
}

first_true_index <- function(x) {
  hit <- which(x)
  if (!length(hit)) return(NA_integer_)
  as.integer(hit[1])
}

select_signature_hierarchical <- function(
    df,
    label,
    tau_col,
    ratio_col,
    tiers,
    target_size,
    exclude = character(0),
    force_named_gene = FALSE,
    named_gene = "AR",
    cor_nepc_sign = ">=",
    cor_ar_sign = "<=",
    cor_ar_limit = 0.3222) {

  named_gene <- clean_genes(named_gene)
  if (length(named_gene) != 1L) {
    stop(label, ": named_gene must resolve to exactly one symbol.")
  }

  all_ranked <- rank_by_score(df) %>%
    dplyr::mutate(
      candidate_rank = dplyr::row_number(),
      excluded_by_fibroblast = gene %in% exclude
    )

  if (any(!is.finite(all_ranked$evidence_score))) {
    stop(label, ": non-finite evidence_score in ranked matrix.")
  }

  gate_pass_by_tier <- lapply(
    seq_len(nrow(tiers)),
    function(i) {
      branch_gate_pass(
        all_ranked,
        tau_col = tau_col,
        ratio_col = ratio_col,
        tau_threshold = tiers$tau_threshold[i],
        ratio_threshold = tiers$ratio_threshold[i],
        min_score = tiers$min_score[i],
        directional_gates = tiers$directional_gates[i],
        require_finite_cor = tiers$require_finite_cor[i],
        cor_nepc_sign = cor_nepc_sign,
        cor_ar_sign = cor_ar_sign,
        cor_ar_limit = cor_ar_limit
      )
    }
  )

  gate_only_first_tier_idx <- vapply(
    seq_len(nrow(all_ranked)),
    function(i) {
      first_true_index(vapply(gate_pass_by_tier, function(v) v[i], logical(1)))
    },
    integer(1)
  )

  gate_only_first_tier <- ifelse(
    is.na(gate_only_first_tier_idx),
    NA_integer_,
    tiers$tier[gate_only_first_tier_idx]
  )

  n_eligible_by_tier <- vapply(
    gate_pass_by_tier,
    function(pass_gate) {
      sum(pass_gate & !all_ranked$excluded_by_fibroblast)
    },
    integer(1)
  )

  sufficient <- which(n_eligible_by_tier >= target_size)
  chosen_idx <- if (length(sufficient)) {
    sufficient[1]
  } else {
    which(n_eligible_by_tier == max(n_eligible_by_tier))[1]
  }

  chosen_tier <- tiers$tier[chosen_idx]
  passes_chosen_tier <- gate_pass_by_tier[[chosen_idx]]

  all_ranked <- all_ranked %>%
    dplyr::mutate(
      first_eligible_tier = gate_only_first_tier,
      chosen_tier = chosen_tier,
      passes_chosen_tier = passes_chosen_tier,
      eligible_at_chosen_tier =
        passes_chosen_tier & !excluded_by_fibroblast,
      forced_AR_requested = force_named_gene,
      mandatory_member = force_named_gene & gene == named_gene,
      added_to_pool_by_rescue = FALSE,
      selected_via_rescue = FALSE,
      eligible_rank = NA_integer_,
      selection_pool_rank = NA_integer_,
      final_signature_rank = NA_integer_,
      signature_rank = NA_integer_,
      selected = FALSE
    )

  ordinary_eligible <- all_ranked %>%
    dplyr::filter(eligible_at_chosen_tier) %>%
    dplyr::mutate(eligible_rank = dplyr::row_number())

  all_ranked$eligible_rank <- match(
    all_ranked$gene,
    ordinary_eligible$gene
  )

  n_take_ordinary <- min(target_size, nrow(ordinary_eligible))
  ordinary_selected <- ordinary_eligible %>%
    dplyr::slice_head(n = n_take_ordinary)

  displaced_genes <- character(0)
  ar_gate_bypass <- FALSE
  ar_rank_cutoff_rescue <- FALSE
  ar_selected <- FALSE

  selection_pool_genes <- ordinary_eligible$gene

  if (force_named_gene) {
    ar_row <- all_ranked %>% dplyr::filter(gene == named_gene)
    if (!nrow(ar_row)) {
      stop(label, ": mandatory gene ", named_gene, " missing from candidate matrix.")
    }
    if (!is.finite(ar_row$evidence_score[1])) {
      stop(label, ": mandatory gene ", named_gene, " has non-finite evidence_score.")
    }
    if (ar_row$excluded_by_fibroblast[1]) {
      stop(
        label,
        ": mandatory gene ", named_gene,
        " is already selected for fibroblast; overlap is forbidden."
      )
    }

    if (!(named_gene %in% selection_pool_genes)) {
      selection_pool_genes <- c(selection_pool_genes, named_gene)
      ar_gate_bypass <- TRUE
      all_ranked$added_to_pool_by_rescue <- all_ranked$gene == named_gene
    }

    if (!(named_gene %in% ordinary_selected$gene)) {
      ar_rank_cutoff_rescue <- !ar_gate_bypass
      keep_non_ar <- ordinary_selected %>%
        dplyr::filter(gene != named_gene)
      keep_non_ar <- keep_non_ar %>%
        dplyr::slice_head(n = max(target_size - 1L, 0L))
      final_genes <- c(keep_non_ar$gene, named_gene)
      displaced_genes <- setdiff(ordinary_selected$gene, final_genes)
    } else {
      final_genes <- ordinary_selected$gene
    }
  } else {
    final_genes <- ordinary_selected$gene
  }

  selection_pool_ranked <- all_ranked %>%
    dplyr::filter(gene %in% selection_pool_genes) %>%
    dplyr::mutate(selection_pool_rank = dplyr::row_number())

  all_ranked$selection_pool_rank <- match(
    all_ranked$gene,
    selection_pool_ranked$gene
  )

  selected <- all_ranked %>%
    dplyr::filter(gene %in% final_genes) %>%
    dplyr::slice_head(n = target_size) %>%
    dplyr::mutate(
      final_signature_rank = dplyr::row_number(),
      signature_rank = final_signature_rank,
      selected = TRUE
    )

  if (force_named_gene) {
    ar_selected <- named_gene %in% selected$gene
    if (!ar_selected) {
      stop(label, ": mandatory gene ", named_gene, " failed to enter final signature.")
    }
    ar_is_ordinary_top <- named_gene %in% ordinary_selected$gene
    selected$selected_via_rescue <- selected$gene == named_gene & !ar_is_ordinary_top
  }

  all_ranked$final_signature_rank <- match(all_ranked$gene, selected$gene)
  all_ranked$signature_rank <- all_ranked$final_signature_rank
  all_ranked$selected <- !is.na(all_ranked$final_signature_rank)
  all_ranked$selected_via_rescue <- all_ranked$gene %in% selected$gene[selected$selected_via_rescue]

  all_ranked <- all_ranked %>%
    dplyr::mutate(
      selection_status = dplyr::case_when(
        selected & selected_via_rescue & added_to_pool_by_rescue ~
          "selected_via_rescue_gate_bypass",
        selected & selected_via_rescue ~
          "selected_via_rescue_rank_cutoff",
        selected ~ "selected",
        excluded_by_fibroblast ~ "excluded_by_fibroblast",
        !passes_chosen_tier ~ "fails_chosen_tier",
        !is.na(selection_pool_rank) ~ "in_selection_pool_not_selected",
        TRUE ~ "below_rank_cutoff"
      )
    )

  selected <- all_ranked %>%
    dplyr::filter(selected) %>%
    dplyr::arrange(final_signature_rank)

  diagnostics <- tibble::tibble(
    branch = label,
    target_size = target_size,
    chosen_tier = chosen_tier,
    n_candidates_measured_in_bulk = nrow(all_ranked),
    n_excluded_by_fibroblast = sum(all_ranked$excluded_by_fibroblast),
    n_gate_pass_chosen_tier = sum(all_ranked$passes_chosen_tier),
    n_eligible_at_chosen_tier = sum(all_ranked$eligible_at_chosen_tier),
    n_selected = nrow(selected),
    target_shortfall = target_size - nrow(selected),
    chosen_tau_threshold = tiers$tau_threshold[chosen_idx],
    chosen_ratio_threshold = tiers$ratio_threshold[chosen_idx],
    chosen_min_score = tiers$min_score[chosen_idx],
    chosen_directional_gates = tiers$directional_gates[chosen_idx],
    chosen_require_finite_cor = tiers$require_finite_cor[chosen_idx],
    mandatory_member_requested = force_named_gene,
    mandatory_member = if (force_named_gene) named_gene else NA_character_,
    mandatory_member_selected = if (force_named_gene) ar_selected else NA,
    mandatory_member_gate_bypass = if (force_named_gene) ar_gate_bypass else NA,
    mandatory_member_rank_cutoff_rescue = if (force_named_gene) ar_rank_cutoff_rescue else NA,
    displaced_genes = paste(sort(displaced_genes), collapse = ";")
  )

  tier_trace <- tiers %>%
    dplyr::mutate(
      branch = label,
      n_eligible_after_exclusion = n_eligible_by_tier,
      chosen_tier = tier == tiers$tier[chosen_idx]
    )

  stopifnot(
    !anyDuplicated(selected$gene),
    nrow(selected) <= target_size,
    all(diff(selected$evidence_score) <= 0)
  )

  list(
    genes = selected$gene,
    table = selected,
    all_ranked = all_ranked,
    ordinary_eligible_ranked = ordinary_eligible,
    selection_pool_ranked = selection_pool_ranked,
    diagnostics = diagnostics,
    tier_trace = tier_trace,
    displaced_genes = displaced_genes
  )
}

run_selection_synthetic_tests <- function() {
  tiers <- cfg$adaptive_tiers
  mdk_up <- 13.5
  mdk_down <- 13.5
  pdgfra_up <- 9.5
  pdgfra_down <- 5.5

  base <- tibble::tibble(
    gene = c("G1", "G2", "PDGFRA", "MDK", "AR", "TIEA", "TIEB"),
    evidence_score = c(12, 11, pdgfra_up, mdk_up, 0.1, 5, 5),
    tau_nepc = c(0.97, 0.93, 0.98376937, 0.82003581, 0.52, 0.80, 0.80),
    ratio_nepc_mean = c(1.7, 1.6, 15.0556864, 0.59540665, 1.0, 1.2, 1.2),
    tau_adeno = c(0.96, 0.90, 0.98232895, 0.7045454, 0.80, 0.80, 0.80),
    ratio_adeno_mean = c(1.8, 1.6, 0.20124987, 0.72567971, 1.0, 1.2, 1.2),
    cor_NEPC = c(0.4, 0.3, 0.06429762, 0.4, 0.10, 0.2, 0.2),
    cor_AR = c(0.2, 0.1, 0.10986979, 0.5, 0.10, 0.2, 0.2)
  )

  # Branch-specific gate behavior and tier relaxation.
  aspc <- select_signature_hierarchical(
    base,
    label = "ASPC",
    tau_col = "tau_nepc",
    ratio_col = "ratio_nepc_mean",
    tiers = tiers,
    target_size = 3,
    force_named_gene = TRUE,
    named_gene = "AR"
  )
  fib <- select_signature_hierarchical(
    base %>% dplyr::mutate(cor_NEPC = -cor_NEPC, cor_AR = abs(cor_AR)),
    label = "FIBRO",
    tau_col = "tau_adeno",
    ratio_col = "ratio_adeno_mean",
    tiers = tiers,
    target_size = 2,
    cor_nepc_sign = "<=",
    cor_ar_sign = ">=",
    cor_ar_limit = 0
  )
  stopifnot(aspc$diagnostics$chosen_tier == 1L)
  stopifnot(fib$diagnostics$chosen_tier == 1L)
  stopifnot(aspc$all_ranked$first_eligible_tier[aspc$all_ranked$gene == "PDGFRA"] == 0L)
  stopifnot(is.na(aspc$all_ranked$first_eligible_tier[aspc$all_ranked$gene == "MDK"]))
  stopifnot(is.na(fib$all_ranked$first_eligible_tier[fib$all_ranked$gene == "PDGFRA"]))
  stopifnot(is.na(fib$all_ranked$first_eligible_tier[fib$all_ranked$gene == "MDK"]))

  up_fixture <- tibble::tibble(
    gene = c("PDGFRA", "MDK", "AR"),
    evidence_score = c(pdgfra_up, mdk_up, 1),
    tau_nepc = c(0.98376937, 0.82003581, 0.60),
    ratio_nepc_mean = c(15.0556864, 0.59540665, 1.0),
    tau_adeno = c(0.7, 0.7, 0.7),
    ratio_adeno_mean = c(1, 1, 1),
    cor_NEPC = c(0.06429762, 0.2, 0.1),
    cor_AR = c(0.10986979, 0.4, 0.1)
  )
  up_fix_sel <- select_signature_hierarchical(
    up_fixture,
    label = "ASPC",
    tau_col = "tau_nepc",
    ratio_col = "ratio_nepc_mean",
    tiers = tiers,
    target_size = 1,
    force_named_gene = FALSE,
    named_gene = "AR"
  )
  stopifnot(up_fix_sel$all_ranked$first_eligible_tier[up_fix_sel$all_ranked$gene == "PDGFRA"] == 0L)
  stopifnot(is.na(up_fix_sel$all_ranked$first_eligible_tier[up_fix_sel$all_ranked$gene == "MDK"]))

  down_fixture <- tibble::tibble(
    gene = c("PDGFRA", "MDK"),
    evidence_score = c(pdgfra_down, mdk_down),
    tau_nepc = c(0.6, 0.6),
    ratio_nepc_mean = c(1, 1),
    tau_adeno = c(0.98232895, 0.7045454),
    ratio_adeno_mean = c(0.20124987, 0.72567971),
    cor_NEPC = c(-0.1, -0.1),
    cor_AR = c(0.1, 0.1)
  )
  down_fix_sel <- select_signature_hierarchical(
    down_fixture,
    label = "FIBRO",
    tau_col = "tau_adeno",
    ratio_col = "ratio_adeno_mean",
    tiers = tiers,
    target_size = 1,
    force_named_gene = FALSE,
    cor_nepc_sign = "<=",
    cor_ar_sign = ">=",
    cor_ar_limit = 0
  )
  stopifnot(is.na(down_fix_sel$all_ranked$first_eligible_tier[down_fix_sel$all_ranked$gene == "PDGFRA"]))
  stopifnot(is.na(down_fix_sel$all_ranked$first_eligible_tier[down_fix_sel$all_ranked$gene == "MDK"]))

  # NA correlations are admitted only in tier7.
  na_cor <- select_signature_hierarchical(
    base %>% dplyr::mutate(cor_NEPC = NA_real_, cor_AR = NA_real_),
    label = "ASPC",
    tau_col = "tau_nepc",
    ratio_col = "ratio_nepc_mean",
    tiers = tiers,
    target_size = 2,
    force_named_gene = TRUE,
    named_gene = "AR"
  )
  stopifnot(na_cor$diagnostics$chosen_tier == 7L)

  # ratio < 1 never passes any tier.
  ratio_fail <- select_signature_hierarchical(
    base %>% dplyr::mutate(ratio_nepc_mean = 0.99),
    label = "ASPC",
    tau_col = "tau_nepc",
    ratio_col = "ratio_nepc_mean",
    tiers = tiers,
    target_size = 2,
    force_named_gene = TRUE,
    named_gene = "AR"
  )
  stopifnot(all(!ratio_fail$all_ranked$passes_chosen_tier))
  stopifnot(identical(ratio_fail$genes, "AR"))

  # Shortage case can return fewer than target.
  shortage <- select_signature_hierarchical(
    base %>% dplyr::filter(gene %in% c("G1", "G2")),
    label = "FIBRO",
    tau_col = "tau_adeno",
    ratio_col = "ratio_adeno_mean",
    tiers = tiers,
    target_size = 5,
    force_named_gene = FALSE,
    cor_nepc_sign = "<=",
    cor_ar_sign = ">=",
    cor_ar_limit = 0
  )
  stopifnot(length(shortage$genes) < 5)

  # Exclusion applies only to selected fibroblast genes.
  aspc_ex <- select_signature_hierarchical(
    base,
    label = "ASPC",
    tau_col = "tau_nepc",
    ratio_col = "ratio_nepc_mean",
    tiers = tiers,
    target_size = 3,
    exclude = c("G1"),
    force_named_gene = TRUE,
    named_gene = "AR"
  )
  stopifnot(!("G1" %in% aspc_ex$genes))
  stopifnot("G2" %in% aspc_ex$genes)

  # Mandatory low-score AR rescue displaces one ordinary top-N gene.
  rescued_ar <- aspc$all_ranked %>% dplyr::filter(gene == "AR")
  stopifnot(rescued_ar$added_to_pool_by_rescue)
  stopifnot(rescued_ar$selected_via_rescue)
  stopifnot("selected_via_rescue_gate_bypass" %in% aspc$all_ranked$selection_status)
  stopifnot(length(aspc$displaced_genes) == 1L)

  # AR already selected naturally -> no duplicate/displacement.
  ar_natural <- select_signature_hierarchical(
    base %>% dplyr::mutate(
      evidence_score = dplyr::if_else(gene == "AR", 20, evidence_score),
      tau_nepc = dplyr::if_else(gene == "AR", 0.97, tau_nepc),
      ratio_nepc_mean = dplyr::if_else(gene == "AR", 1.8, ratio_nepc_mean),
      cor_NEPC = dplyr::if_else(gene == "AR", 0.20, cor_NEPC),
      cor_AR = dplyr::if_else(gene == "AR", 0.10, cor_AR)
    ),
    label = "ASPC",
    tau_col = "tau_nepc",
    ratio_col = "ratio_nepc_mean",
    tiers = tiers,
    target_size = 3,
    force_named_gene = TRUE,
    named_gene = "AR"
  )
  stopifnot(!ar_natural$all_ranked$selected_via_rescue[ar_natural$all_ranked$gene == "AR"])
  stopifnot(length(ar_natural$displaced_genes) == 0L)

  # target_size = 1 returns AR-only when forced.
  ar_only <- select_signature_hierarchical(
    base,
    label = "ASPC",
    tau_col = "tau_nepc",
    ratio_col = "ratio_nepc_mean",
    tiers = tiers,
    target_size = 1,
    force_named_gene = TRUE,
    named_gene = "AR"
  )
  stopifnot(identical(ar_only$genes, "AR"))

  # Missing/non-finite AR are explicit errors.
  err_missing <- tryCatch(
    select_signature_hierarchical(
      base %>% dplyr::filter(gene != "AR"),
      label = "ASPC",
      tau_col = "tau_nepc",
      ratio_col = "ratio_nepc_mean",
      tiers = tiers,
      target_size = 2,
      force_named_gene = TRUE,
      named_gene = "AR"
    ),
    error = function(e) e
  )
  stopifnot(inherits(err_missing, "error"))

  err_nonfinite <- tryCatch(
    select_signature_hierarchical(
      base %>% dplyr::mutate(evidence_score = dplyr::if_else(gene == "AR", NA_real_, evidence_score)),
      label = "ASPC",
      tau_col = "tau_nepc",
      ratio_col = "ratio_nepc_mean",
      tiers = tiers,
      target_size = 2,
      force_named_gene = TRUE,
      named_gene = "AR"
    ),
    error = function(e) e
  )
  stopifnot(inherits(err_nonfinite, "error"))

  # Fibroblast conflict on AR is explicit.
  err_conflict <- tryCatch(
    select_signature_hierarchical(
      base,
      label = "ASPC",
      tau_col = "tau_nepc",
      ratio_col = "ratio_nepc_mean",
      tiers = tiers,
      target_size = 2,
      exclude = "AR",
      force_named_gene = TRUE,
      named_gene = "AR"
    ),
    error = function(e) e
  )
  stopifnot(inherits(err_conflict, "error"))

  # Tie ordering is alphabetic.
  tie_df <- base %>% dplyr::mutate(
    evidence_score = dplyr::if_else(gene %in% c("TIEA", "TIEB"), 5, evidence_score)
  )
  tie_sel <- select_signature_hierarchical(
    tie_df %>% dplyr::mutate(cor_NEPC = -abs(cor_NEPC), cor_AR = abs(cor_AR)),
    label = "FIBRO",
    tau_col = "tau_adeno",
    ratio_col = "ratio_adeno_mean",
    tiers = tiers,
    target_size = 7,
    cor_nepc_sign = "<=",
    cor_ar_sign = ">=",
    cor_ar_limit = -1
  )
  tie_genes <- tie_sel$all_ranked$gene[tie_sel$all_ranked$evidence_score == 5]
  stopifnot(identical(tie_genes, sort(tie_genes)))

  # Size, uniqueness, score preservation, and ranked output consistency.
  stopifnot(length(unique(aspc$genes)) == length(aspc$genes))
  stopifnot(length(aspc$genes) <= 3)
  ar_score_out <- aspc$table$evidence_score[aspc$table$gene == "AR"]
  stopifnot(identical(ar_score_out, base$evidence_score[base$gene == "AR"]))
  selected_from_matrix <- aspc$all_ranked %>%
    dplyr::filter(selected) %>%
    dplyr::arrange(final_signature_rank) %>%
    dplyr::pull(gene)
  stopifnot(identical(selected_from_matrix, aspc$genes))
}

if (identical(tolower(Sys.getenv("RUN_SIGNATURE_SELECTION_SYNTHETIC_TESTS", "false")), "true")) {
  run_selection_synthetic_tests()
  msg("Synthetic selection tests passed.")
  quit(save = "no", status = 0L)
}

