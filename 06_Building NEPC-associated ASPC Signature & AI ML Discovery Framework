# Walked top to bottom. The FIRST tier yielding >= target_size genes is used;
# ranking then selects the top N within it. Tier 0 reproduces v5 exactly.
build_tiers <- function() {
  list(
    list(id = 0, label = "strict (v5)",
         tau = 0.95, ratio = 1.50, score = 1.0, cor_gates = TRUE,  require_cor = TRUE),
    list(id = 1, label = "tau 0.90",
         tau = 0.90, ratio = 1.50, score = 1.0, cor_gates = TRUE,  require_cor = TRUE),
    list(id = 2, label = "tau 0.85 / ratio 1.3",
         tau = 0.85, ratio = 1.30, score = 1.0, cor_gates = TRUE,  require_cor = TRUE),
    list(id = 3, label = "tau 0.80 / ratio 1.2",
         tau = 0.80, ratio = 1.20, score = 1.0, cor_gates = TRUE,  require_cor = TRUE),
    list(id = 4, label = "tau 0.75 / ratio 1.1 / score 0.5",
         tau = 0.75, ratio = 1.10, score = 0.5, cor_gates = TRUE,  require_cor = TRUE),
    list(id = 5, label = "tau 0.70 / ratio 1.0 / score 0.5",
         tau = 0.70, ratio = 1.00, score = 0.5, cor_gates = TRUE,  require_cor = TRUE),
    list(id = 6, label = "tau 0.60 / correlation gates dropped",
         tau = 0.60, ratio = 1.00, score = 0.5, cor_gates = FALSE, require_cor = TRUE),
    list(id = 7, label = "tau 0.50 / cor gates dropped / NA cor allowed",
         tau = 0.50, ratio = 1.00, score = 0.0, cor_gates = FALSE, require_cor = FALSE)
  )
}

