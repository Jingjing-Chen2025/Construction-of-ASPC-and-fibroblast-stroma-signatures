    list(id = 2L, label = "tau 0.85 / ratio 1.3",
         tau = 0.85, ratio = 1.30, cor_gates = TRUE, require_cor = TRUE),
    list(id = 3L, label = "tau 0.80 / ratio 1.2",
         tau = 0.80, ratio = 1.20, cor_gates = TRUE, require_cor = TRUE),
    list(id = 4L, label = "tau 0.75 / ratio 1.1",
         tau = 0.75, ratio = 1.10, cor_gates = TRUE, require_cor = TRUE),
    list(id = 5L, label = "tau 0.70 / ratio 1.0",
         tau = 0.70, ratio = 1.00, cor_gates = TRUE, require_cor = TRUE),
    list(id = 6L, label = "tau 0.60 / correlation gates dropped",
         tau = 0.60, ratio = 1.00, cor_gates = FALSE, require_cor = TRUE),
