hdr("STEP 10 — surface ranking audit")

surface_audit_one <- function(sel, label) {
  n_take <- nrow(sel$table)

  evidence_only_top <- rank_by_score(
    sel$ordinary_eligible_ranked,
    "evidence_only_score"
  ) %>%
    dplyr::slice_head(n = n_take)

  tibble::tibble(
    branch = label,
    surface_source = surface_source,
    n_selected = n_take,
    n_surface_total_score_ranking = sum(sel$table$is_surface),
    n_surface_measured_evidence_ranking =
      sum(evidence_only_top$is_surface),
    n_genes_shared_between_rankings =
      length(intersect(sel$table$gene, evidence_only_top$gene)),
    audit_scope = "same_branch_pool_same_exclusion_no_reselection"
  )
}

if (cfg$surface_audit) {
  surface_audit <- dplyr::bind_rows(
    surface_audit_one(aspc_sel, "ASPC"),
    surface_audit_one(fib_sel, "FIBROBLAST_STROMA")
  )
  write_result(surface_audit, "signature_surface_ranking_audit.csv")
  print(surface_audit)
}

