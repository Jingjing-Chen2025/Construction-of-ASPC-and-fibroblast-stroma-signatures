hdr("STEP 9 — adaptive filters, score ranking, signature construction")

rank_by_score <- function(df, score_column = "evidence_score") {
  # Gene symbol only resolves exact score ties deterministically.
  df %>%
    dplyr::arrange(
      dplyr::desc(.data[[score_column]]),
      gene
    )
}

# Apply one tier of the ladder. Returns a logical keep vector over df rows.
# tau_used / ratio_used are the branch-specific columns set in build_evidence.
tier_filter <- function(df, tr, direction) {
  tau_thr <- max(tr$tau, cfg$tau_floor)
  ratio_thr <- max(tr$ratio, cfg$ratio_floor)

  keep <-
    is.finite(df$tau_used) & df$tau_used >= tau_thr &
    is.finite(df$ratio_used) & df$ratio_used >= ratio_thr

  if (isTRUE(tr$require_cor)) {
    keep <- keep & is.finite(df$cor_NEPC) & is.finite(df$cor_AR)
  }

  if (isTRUE(tr$cor_gates)) {
    if (identical(direction, "up")) {
      keep <- keep &
        is.finite(df$cor_NEPC) & df$cor_NEPC >= cfg$cor_NEPC_min &
        is.finite(df$cor_AR) & df$cor_AR <= cfg$cor_AR_max
    } else {
      keep <- keep &
        is.finite(df$cor_NEPC) & df$cor_NEPC <= cfg$cor_NEPC_down_max &
        is.finite(df$cor_AR) & df$cor_AR >= cfg$cor_AR_down_min
    }
  }

  keep
}

tier_table_row <- function(tr, label, direction, n_pool, n_eligible) {
  # Pull tier fields into plain scalars first: inside tibble() the column
  # named `tier` would otherwise shadow the tier list in later arguments.
  tier_id <- tr$id
  tier_lab <- tr$label
  tau_thr <- max(tr$tau, cfg$tau_floor)
  ratio_thr <- max(tr$ratio, cfg$ratio_floor)
  gates <- isTRUE(tr$cor_gates)
  finite_cor <- isTRUE(tr$require_cor)
  target_met <- n_eligible >= cfg$target_size

  tibble::tibble(
    branch = label,
    direction = direction,
    tier = tier_id,
    tier_label = tier_lab,
    tau_threshold = tau_thr,
    ratio_threshold = ratio_thr,
    correlation_gates = gates,
    require_finite_correlations = finite_cor,
    n_pool_after_exclusion = n_pool,
    n_eligible = n_eligible,
    meets_target = target_met
  )
}

select_signature <- function(
    df,
    label,
    direction,
    exclude = character(0),
    forced_genes = character(0)) {

  exclude <- clean_genes(exclude)
  forced_genes <- clean_genes(forced_genes)

  # ---- 1. full candidate matrix, ranked ------------------------------------
  all_ranked <- rank_by_score(df) %>%
    dplyr::mutate(
      candidate_rank = dplyr::row_number(),
      excluded_by_other_signature = gene %in% exclude
    )

  # ---- 2. exclusion by the other signature ---------------------------------
  pool <- all_ranked %>%
    dplyr::filter(!excluded_by_other_signature)

  # ---- 3. adaptive filters --------------------------------------------------
  tiers <- build_tiers()
  if (identical(cfg$selection_mode, "strict")) tiers <- tiers[1]
  if (identical(cfg$selection_mode, "loosest")) tiers <- tiers[length(tiers)]

  trace <- list()
  chosen_keep <- NULL
  chosen_tier <- NULL
  best_n <- -1L

  for (tr in tiers) {
    keep <- tier_filter(pool, tr, direction)
    n_keep <- sum(keep)

    trace[[length(trace) + 1L]] <- tier_table_row(
      tr, label, direction, nrow(pool), n_keep
    )

    cat(sprintf(
      "  tier %d  %-46s eligible = %5d\n",
      tr$id, tr$label, n_keep
    ))

    if (n_keep > best_n) {
      chosen_keep <- keep
      chosen_tier <- tr
      best_n <- n_keep
    }
    if (n_keep >= cfg$target_size) {
      chosen_keep <- keep
      chosen_tier <- tr
      break
    }
  }

  chosen_tier_id <- chosen_tier$id
  trace_df <- dplyr::bind_rows(trace)
  trace_df$tier_used <- trace_df$tier == chosen_tier_id

  eligible_ranked <- pool[chosen_keep, , drop = FALSE] %>%
    dplyr::mutate(eligible_rank = dplyr::row_number())

  msg(
    "%s: tier %d ('%s') -> %d eligible of %d after exclusion.",
    label, chosen_tier$id, chosen_tier$label,
    nrow(eligible_ranked), nrow(pool)
  )
  msg(
    "  effective filters: tau >= %.2f | ratio >= %.2f | correlation gates %s | finite cor %s",
    max(chosen_tier$tau, cfg$tau_floor),
    max(chosen_tier$ratio, cfg$ratio_floor),
    ifelse(isTRUE(chosen_tier$cor_gates), "ON", "OFF"),
    ifelse(isTRUE(chosen_tier$require_cor), "required", "not required")
  )

  # ---- 4. rank eligible candidates and select the top N --------------------
  n_take <- min(cfg$target_size, nrow(eligible_ranked))

  selected <- eligible_ranked %>%
    dplyr::slice_head(n = n_take) %>%
    dplyr::mutate(forced_inclusion = FALSE)

  # ---- 5. forced inclusion ---------------------------------------------------
  # A forced gene bypasses the adaptive filters. It still has to be in the
  # branch candidate matrix (measured in bulk) and must not be claimed by the
  # other signature. When the signature is full, the lowest-ranked ordinary
  # (non-forced) selected gene is displaced.
  forced_added <- character(0)
  displaced <- character(0)
  forced_rows <- list()

  for (g in forced_genes) {
    in_matrix <- g %in% all_ranked$gene
    excluded <- g %in% exclude
    passes_filter <- g %in% eligible_ranked$gene
    already_selected <- g %in% selected$gene
    added <- FALSE
    displaced_gene <- NA_character_
    outcome <- NA_character_

    if (!in_matrix) {
      outcome <- "not_in_candidate_matrix"
      warn_msg(
        "%s: forced gene %s is not in the candidate matrix (not measured in bulk?).",
        label, g
      )
    } else if (excluded) {
      outcome <- "blocked_by_other_signature"
      warn_msg(
        "%s: forced gene %s belongs to the other signature; not forced.",
        label, g
      )
    } else if (already_selected) {
      outcome <- "selected_ordinarily"
    } else {
      if (nrow(selected) >= cfg$target_size) {
        ordinary_idx <- which(!selected$forced_inclusion)
        if (!length(ordinary_idx)) {
          outcome <- "no_ordinary_gene_to_displace"
          warn_msg(
            "%s: forced gene %s cannot be added; signature is full of forced genes.",
            label, g
          )
        } else {
          # selected keeps its score order among ordinary rows, so the last
          # ordinary row is the lowest-ranked ordinary selected gene.
          drop_i <- max(ordinary_idx)
          displaced_gene <- selected$gene[drop_i]
          displaced <- c(displaced, displaced_gene)
          selected <- selected[-drop_i, , drop = FALSE]
        }
      }

      if (is.na(outcome)) {
        forced_row <- pool %>%
          dplyr::filter(gene == g) %>%
          dplyr::mutate(
            eligible_rank = if (passes_filter) {
              eligible_ranked$eligible_rank[
                match(g, eligible_ranked$gene)
              ]
            } else {
              NA_integer_
            },
            forced_inclusion = TRUE
          )
        selected <- dplyr::bind_rows(selected, forced_row)
        forced_added <- c(forced_added, g)
        added <- TRUE
        outcome <- if (is.na(displaced_gene)) {
          "forced_added_to_open_slot"
        } else {
          "forced_added_by_displacement"
        }
        msg(
          "%s: forced inclusion of %s (%s).",
          label, g,
          if (is.na(displaced_gene)) "open slot"
          else paste0("displaced ", displaced_gene)
        )
      }
    }

    forced_rows[[length(forced_rows) + 1L]] <- tibble::tibble(
      branch = label,
      gene = g,
      in_candidate_matrix = in_matrix,
      excluded_by_other_signature = excluded,
      passes_adaptive_filter = passes_filter,
      selected_ordinarily = already_selected,
      forced_added = added,
      displaced_gene = displaced_gene,
      outcome = outcome
    )
  }

  forced_diag <- if (length(forced_rows)) {
    dplyr::bind_rows(forced_rows)
  } else {
    tibble::tibble(
      branch = character(),
      gene = character(),
      in_candidate_matrix = logical(),
      excluded_by_other_signature = logical(),
      passes_adaptive_filter = logical(),
      selected_ordinarily = logical(),
      forced_added = logical(),
      displaced_gene = character(),
      outcome = character()
    )
  }

  # ---- 6. final ranking by descending evidence_score -----------------------
  selected <- rank_by_score(selected) %>%
    dplyr::mutate(
      signature_rank = dplyr::row_number(),
      selected = TRUE
    )

  # ---- 7. annotate the complete candidate ranking --------------------------
  all_ranked$passes_adaptive_filter <- all_ranked$gene %in% eligible_ranked$gene
  all_ranked$eligible_rank <- eligible_ranked$eligible_rank[
    match(all_ranked$gene, eligible_ranked$gene)
  ]
  all_ranked$signature_rank <- selected$signature_rank[
    match(all_ranked$gene, selected$gene)
  ]
  all_ranked$selected <- !is.na(all_ranked$signature_rank)
  all_ranked$forced_inclusion <- all_ranked$gene %in% forced_added
  all_ranked$displaced_by_forced_gene <- all_ranked$gene %in% displaced

  all_ranked <- all_ranked %>%
    dplyr::mutate(
      selection_status = dplyr::case_when(
        excluded_by_other_signature ~ "excluded_by_other_signature",
        forced_inclusion ~ "selected_forced",
        selected ~ "selected",
        displaced_by_forced_gene ~ "displaced_by_forced_gene",
        !passes_adaptive_filter ~ "failed_adaptive_filter",
        TRUE ~ "below_top_n"
      )
    )

  ordinary_selected <- selected %>% dplyr::filter(!forced_inclusion)

  cutoff <- if (nrow(ordinary_selected)) {
    min(ordinary_selected$evidence_score)
  } else {
    NA_real_
  }

  diagnostics <- tibble::tibble(
    branch = label,
    direction = direction,
    selection_method =
      "adaptive_tau_ratio_correlation_filter_then_evidence_score_desc_gene_asc",
    selection_mode = cfg$selection_mode,
    target_size = cfg$target_size,
    tier_used = chosen_tier$id,
    tier_label = chosen_tier$label,
    tau_threshold_used = max(chosen_tier$tau, cfg$tau_floor),
    ratio_threshold_used = max(chosen_tier$ratio, cfg$ratio_floor),
    correlation_gates_used = isTRUE(chosen_tier$cor_gates),
    n_candidates_measured_in_bulk = nrow(df),
    n_excluded_by_other_signature =
      sum(all_ranked$excluded_by_other_signature),
    n_pool_after_exclusion = nrow(pool),
    n_failed_adaptive_filter = nrow(pool) - nrow(eligible_ranked),
    n_eligible = nrow(eligible_ranked),
    n_selected = nrow(selected),
    n_selected_ordinary = nrow(ordinary_selected),
    n_forced_added = length(forced_added),
    forced_genes_added = paste(forced_added, collapse = ";"),
    n_displaced_by_forced_gene = length(displaced),
    displaced_genes = paste(displaced, collapse = ";"),
    target_shortfall = cfg$target_size - nrow(selected),
    cutoff_evidence_score_ordinary = cutoff,
    n_eligible_tied_at_cutoff = if (is.finite(cutoff)) {
      sum(eligible_ranked$evidence_score == cutoff)
    } else {
      0L
    },
    n_selected_zero_total_score =
      sum(selected$evidence_score == 0),
    n_selected_zero_measured_evidence =
      sum(selected$evidence_only_score == 0),
    n_selected_missing_tau =
      sum(!is.finite(selected$tau_used)),
    n_selected_missing_ratio =
      sum(!is.finite(selected$ratio_used)),
    n_selected_missing_partial_corr =
      sum(!is.finite(selected$partial_corr)),
    n_selected_missing_trait_cor =
      sum(!is.finite(selected$cor_NEPC) | !is.finite(selected$cor_AR)),
    n_selected_surface = sum(selected$is_surface)
  )

  if (nrow(selected) < cfg$target_size) {
    warn_msg(
      "%s: selected %d/%d; even the loosest tier (tau >= %.2f, ratio >= %.2f) leaves too few genes.",
      label, nrow(selected), cfg$target_size,
      cfg$tau_floor, cfg$ratio_floor
    )
  }

  if (!isTRUE(chosen_tier$cor_gates)) {
    warn_msg(
      "%s: tier %d drops the correlation gates. Describe this signature as",
      label, chosen_tier$id
    )
    warn_msg(
      "  'top %d by evidence among genes with tau >= %.2f', not as",
      nrow(selected), max(chosen_tier$tau, cfg$tau_floor)
    )
    warn_msg("  'genes with high cell-type specificity'.")
  }

  if (any(selected$evidence_only_score == 0)) {
    warn_msg(
      "%s: %d selected genes have zero measured-evidence points.",
      label,
      sum(selected$evidence_only_score == 0)
    )
  }

  if (any(selected$evidence_score == 0)) {
    warn_msg(
      "%s: %d zero-total-score genes selected to fill the target.",
      label,
      sum(selected$evidence_score == 0)
    )
  }

  # Internal ordering and membership checks.
  stopifnot(
    nrow(selected) <= cfg$target_size,
    !anyDuplicated(selected$gene),
    !any(selected$gene %in% exclude),
    all(diff(selected$evidence_score) <= 0),
    all(ordinary_selected$gene %in% eligible_ranked$gene),
    all(forced_added %in% forced_genes),
    !any(displaced %in% selected$gene),
    setequal(
      ordinary_selected$gene,
      setdiff(head(eligible_ranked$gene, n_take), displaced)
    )
  )

  msg(
    "%s: %d candidates; %d excluded; %d failed filters; %d eligible; %d selected (%d forced).",
    label,
    nrow(df),
    sum(all_ranked$excluded_by_other_signature),
    nrow(pool) - nrow(eligible_ranked),
    nrow(eligible_ranked),
    nrow(selected),
    length(forced_added)
  )

  list(
    genes = selected$gene,
    table = selected,
    all_ranked = all_ranked,
    eligible_ranked = eligible_ranked,
    tier = chosen_tier,
    trace = trace_df,
    forced = forced_diag,
    forced_added = forced_added,
    displaced = displaced,
    diagnostics = diagnostics
  )
}

