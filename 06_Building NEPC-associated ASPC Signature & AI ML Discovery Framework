safe_make_names <- function(nms){
  nms2 <- nms
  nms2[is.na(nms2) | nms2 == ""] <- paste0("X_UNNAMED_", seq_len(sum(is.na(nms2) | nms2 == "")))
  make.unique(nms2)
}
