norm_name <- function(x) {
  gsub("[^a-z0-9]+", "", tolower(trimws(x)))
}

find_column <- function(df, candidates) {
  actual <- norm_name(names(df))
  for (candidate in candidates) {
    hit <- match(norm_name(candidate), actual)
    if (!is.na(hit)) return(names(df)[hit])
  }
  NA_character_
}

read_cspa_sheet <- function(path, sheet, species) {
  df <- tryCatch(
    readxl::read_excel(path, sheet = sheet),
    error = function(e) {
      warn_msg(
        "CSPA %s sheet unreadable: %s",
        species, conditionMessage(e)
      )
      NULL
    }
  )
  if (is.null(df) || !nrow(df)) return(character(0))

  sym_col <- find_column(
    df,
    c("ENTREZ gene symbol", "gene symbol", "GeneSymbol", "symbol")
  )
  cat_col <- find_column(
    df,
    c("CSPA category", "category")
  )
  uni_col <- find_column(
    df,
    c("UniProt Cell surface", "Cell surface")
  )

  if (is.na(sym_col)) {
    warn_msg("CSPA %s has no symbol column; skipping.", species)
    return(character(0))
  }

  # Fail closed for unreadable required filters rather than silently
  # treating an unfiltered workbook as a high-confidence surface list.
  if (cfg$cspa_require_category1 && is.na(cat_col)) {
    warn_msg("CSPA %s lacks required category column.", species)
    return(character(0))
  }
  if (cfg$cspa_require_uniprot && is.na(uni_col)) {
    warn_msg("CSPA %s lacks required surface flag column.", species)
    return(character(0))
  }

  keep <- rep(TRUE, nrow(df))

  if (cfg$cspa_require_category1) {
    category <- trimws(as.character(df[[cat_col]]))
    keep <- keep & !is.na(category) &
      grepl("^1($|[^0-9])", category)
  }

  if (cfg$cspa_require_uniprot) {
    flag <- tolower(trimws(as.character(df[[uni_col]])))
    keep <- keep & flag %in% c("yes", "y", "true", "1")
  }

  symbols <- unlist(strsplit(
    as.character(df[[sym_col]][which(keep)]),
    "[;,]"
  ))

  out <- clean_genes(symbols)
  msg("CSPA %s: %d retained symbols", species, length(out))
  out
}

