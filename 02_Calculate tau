# Yanai tau. Returns 0 for genes with no expression anywhere.
calc_tau_from_pseudobulk <- function(pb_mat) {
  apply(pb_mat, 1, function(x) {
    mx <- max(x, na.rm = TRUE)
    if (!is.finite(mx) || mx <= 0) return(0)
    sum(1 - (x / mx), na.rm = TRUE) / (length(x) - 1)
  })
}

# gene x cluster ratio: mean in cluster k over max mean across all other clusters
calc_cluster_ratios <- function(pb_mat) {
  lev <- colnames(pb_mat)
  out <- sapply(seq_along(lev), function(i) {
    tgt   <- pb_mat[, i]
    other <- pb_mat[, -i, drop = FALSE]
    omax  <- if (ncol(other) == 0) rep(0, length(tgt)) else apply(other, 1, max, na.rm = TRUE)
    ifelse(omax > 0, tgt / omax, ifelse(tgt > 0, Inf, 0))
  })
  colnames(out) <- paste0("ratio_cluster_", lev)
  rownames(out) <- rownames(pb_mat)
  out
}

# Extract a genes x cells matrix and a per-cell cluster vector from a
# Seurat object written by the batch pipeline.
extract_matrix_and_clusters <- function(so) {
  if (inherits(so[["RNA"]], "Assay5")) so <- JoinLayers(so)

  layers <- SeuratObject::Layers(so[["RNA"]])
  use <- if (cfg$assay_layer %in% layers) cfg$assay_layer else {
    warn_msg("  Layer '%s' absent; falling back to 'counts'.", cfg$assay_layer)
    "counts"
  }
  mat <- GetAssayData(so, assay = "RNA", layer = use)

  if (!"seurat_clusters" %in% colnames(so@meta.data)) {
    stop("No 'seurat_clusters' column in metadata — was this object written by the batch pipeline?")
  }
  cl <- as.character(so$seurat_clusters)
  names(cl) <- colnames(so)

  list(mat = mat, clusters = cl, layer = use)
}

build_pseudobulk <- function(mat, clusters) {
  clusters <- clusters[colnames(mat)]
  keep <- !is.na(clusters)
  mat <- mat[, keep, drop = FALSE]
  clusters <- clusters[keep]

  # drop tiny clusters
  tab <- table(clusters)
  small <- names(tab)[tab < cfg$min_cells_per_cluster]
  if (length(small)) {
    warn_msg("  Dropping %d cluster(s) with < %d cells: %s",
             length(small), cfg$min_cells_per_cluster, paste(small, collapse = ", "))
    keep2 <- !(clusters %in% small)
    mat <- mat[, keep2, drop = FALSE]
    clusters <- clusters[keep2]
  }

  lev <- sort(unique(clusters))
  if (length(lev) < 2) {
    stop("Fewer than 2 usable clusters — tau is undefined. ",
         "Raise cfg$resolution in the batch pipeline and re-run this cohort.")
  }

  # drop barely-detected genes
  det <- Matrix::rowSums(mat > 0)
  keep_g <- det >= cfg$min_cells_expressing
  msg("  Genes retained: %d / %d (detected in >= %d cells)",
      sum(keep_g), length(keep_g), cfg$min_cells_expressing)
  mat <- mat[keep_g, , drop = FALSE]

  pb <- sapply(lev, function(k) {
    cells <- names(clusters)[clusters == k]
    Matrix::rowMeans(mat[, cells, drop = FALSE])
  })
  rownames(pb) <- rownames(mat)
  colnames(pb) <- lev

  attr(pb, "cluster_sizes") <- as.integer(table(clusters)[lev])
  pb
}

# ============================================================================
# PER-COHORT PROCESSING
# ============================================================================
process_cohort_tau <- function(co) {
  hdr("TAU: %s", co$name)

  rds <- file.path(co$dir, "seurat_merged.rds")
  if (!file.exists(rds)) {
    stop("seurat_merged.rds not found in ", co$dir,
         " — run scRNA_batch_pipeline.R for this cohort first")
  }
  if (file.access(co$dir, mode = 2) != 0) stop("Directory not writable: ", co$dir)

  msg("Reading %s", rds)
  so <- readRDS(rds)

  ex <- extract_matrix_and_clusters(so)
  msg("Matrix: %d genes x %d cells (layer '%s')", nrow(ex$mat), ncol(ex$mat), ex$layer)
  msg("Clusters: %d", length(unique(ex$clusters)))

  pb <- build_pseudobulk(ex$mat, ex$clusters)
  sizes <- attr(pb, "cluster_sizes")
  msg("Pseudobulk: %d genes x %d clusters (sizes: %s)",
      nrow(pb), ncol(pb), paste(sizes, collapse = ", "))

  rm(so, ex); gc(verbose = FALSE)

  tau <- calc_tau_from_pseudobulk(pb)

  genes_out <- rownames(pb)
  if (isTRUE(cfg$uppercase_genes)) genes_out <- toupper(genes_out)

  tau_tbl <- tibble(
    gene         = genes_out,
    tau          = as.numeric(tau),
    n_clusters   = ncol(pb),
    dataset      = co$name,
    cohort_group = co$group,
    species      = co$species
  ) %>%
    group_by(gene) %>%                      # collapse case-merge duplicates
    summarise(tau = max(tau, na.rm = TRUE),
              n_clusters = first(n_clusters),
              dataset = first(dataset),
              cohort_group = first(cohort_group),
              species = first(species),
              .groups = "drop")

  out_tau <- file.path(co$dir, paste0(co$name, "_tau.csv"))
  readr::write_csv(tau_tbl, out_tau)
  msg("Wrote: %s", out_tau)

  saveRDS(pb, file.path(co$dir, paste0(co$name, "_pseudobulk.rds")))

  # ---- optional gene x cluster ratio table ----
  if (isTRUE(cfg$write_ratio_table)) {
    ratios <- calc_cluster_ratios(pb)
    ratio_tbl <- as_tibble(as.data.frame(ratios), rownames = "gene") %>%
      mutate(gene = if (cfg$uppercase_genes) toupper(gene) else gene,
             dataset = co$name, cohort_group = co$group)
    out_ratio <- file.path(co$dir, paste0(co$name, "_cluster_ratio.csv"))
    readr::write_csv(ratio_tbl, out_ratio)
    msg("Wrote: %s", out_ratio)
  }

  # ---- tau distribution diagnostic ----
  n_pass <- sum(tau_tbl$tau >= cfg$tau_threshold_06, na.rm = TRUE)
  pct    <- 100 * n_pass / nrow(tau_tbl)
  msg("Genes with tau >= %.2f : %d (%.1f%%)  [06_ hard filter]",
      cfg$tau_threshold_06, n_pass, pct)
  if (n_pass < 50) {
    warn_msg("Only %d genes clear the 06_ tau cutoff. With %d clusters this may reflect a coarse partition rather than biology.",
             n_pass, ncol(pb))
  }

  p <- ggplot(tau_tbl, aes(x = tau)) +
    geom_histogram(bins = 60, fill = "grey40") +
    geom_vline(xintercept = cfg$tau_threshold_06, colour = "red", linetype = 2) +
    labs(title = paste0(co$name, " — tau distribution"),
         subtitle = sprintf("%d clusters | %d genes | %d pass tau >= %.2f",
                            ncol(pb), nrow(tau_tbl), n_pass, cfg$tau_threshold_06),
         x = "tau", y = "genes") +
    theme_minimal(base_size = 11)
  pdf(file.path(co$dir, paste0(co$name, "_tau_distribution.pdf")), width = 7, height = 5)
  print(p); dev.off()

  rm(pb); gc(verbose = FALSE)

  list(
    tau_tbl = tau_tbl,
    log = data.frame(cohort = co$name, dir = co$dir, group = co$group,
                     status = "ok", n_genes = nrow(tau_tbl),
                     n_clusters = tau_tbl$n_clusters[1],
                     n_pass_tau95 = n_pass, pct_pass = round(pct, 2),
                     stringsAsFactors = FALSE)
  )
}

# ============================================================================
# MAIN LOOP
# ============================================================================
all_tau <- list()
run_log <- list()

for (co in cohorts) {
  t0 <- Sys.time()
  res <- tryCatch(process_cohort_tau(co), error = function(e) {
    warn_msg("COHORT FAILED [%s]: %s", co$name, conditionMessage(e))
    list(tau_tbl = NULL,
         log = data.frame(cohort = co$name, dir = co$dir, group = co$group,
                          status = paste("failed:", conditionMessage(e)),
                          n_genes = NA_integer_, n_clusters = NA_integer_,
                          n_pass_tau95 = NA_integer_, pct_pass = NA_real_,
                          stringsAsFactors = FALSE))
  })
  res$log$minutes <- round(as.numeric(difftime(Sys.time(), t0, units = "mins")), 2)
  run_log[[length(run_log) + 1]] <- res$log
  if (!is.null(res$tau_tbl)) all_tau[[co$name]] <- res$tau_tbl
  gc(verbose = FALSE)
}

run_log_df <- bind_rows(run_log)
print(run_log_df)

# ============================================================================
# POOLED TAU TABLES — the two files 06_ actually reads
# ============================================================================
hdr("POOLING TAU TABLES FOR 06_")

pool_and_write <- function(group_name, root) {
  tabs <- all_tau[vapply(all_tau, function(t) t$cohort_group[1] == group_name, logical(1))]
  if (!length(tabs)) {
    warn_msg("No successful cohorts for group %s; skipping pooled file.", group_name)
    return(NULL)
  }

  long <- bind_rows(tabs)

  pooled <- long %>%
    group_by(gene) %>%
    summarise(
      tau             = median(tau, na.rm = TRUE),
      tau_mean        = mean(tau, na.rm = TRUE),
      tau_max         = max(tau, na.rm = TRUE),
      tau_min         = min(tau, na.rm = TRUE),
      n_datasets      = n_distinct(dataset),
      n_datasets_high = sum(tau >= cfg$tau_threshold_06, na.rm = TRUE),
      .groups = "drop"
    ) %>%
    arrange(desc(tau))

  out <- file.path(root, sprintf("tau_%s_all_datasets.csv", group_name))
  readr::write_csv(pooled, out)
  msg("Wrote pooled %s table: %s  (%d genes from %d cohorts)",
      group_name, out, nrow(pooled), length(tabs))

  readr::write_csv(long, file.path(root, sprintf("tau_%s_per_dataset_long.csv", group_name)))

  n_pass <- sum(pooled$tau >= cfg$tau_threshold_06, na.rm = TRUE)
  msg("  Pooled genes clearing tau >= %.2f : %d (%.1f%%)",
      cfg$tau_threshold_06, n_pass, 100 * n_pass / nrow(pooled))

  pooled
}

pooled_nepc  <- pool_and_write("NEPC",  NEPC_ROOT)
pooled_adeno <- pool_and_write("Adeno", ADENO_ROOT)

# ============================================================================
# THRESHOLD DIAGNOSTICS
# ============================================================================
threshold_grid <- c(0.5, 0.6, 0.7, 0.8, 0.85, 0.9, 0.95, 0.99)

diag_rows <- list()
for (nm in names(all_tau)) {
  t <- all_tau[[nm]]
  for (th in threshold_grid) {
    diag_rows[[length(diag_rows) + 1]] <- data.frame(
      dataset = nm, group = t$cohort_group[1], n_clusters = t$n_clusters[1],
      threshold = th, n_genes_pass = sum(t$tau >= th, na.rm = TRUE),
      pct_pass = round(100 * mean(t$tau >= th, na.rm = TRUE), 2),
      stringsAsFactors = FALSE)
  }
}

if (length(diag_rows)) {
  diag_df <- bind_rows(diag_rows)
  for (root in unique(c(NEPC_ROOT, ADENO_ROOT))) {
    if (dir.exists(root) && file.access(root, mode = 2) == 0) {
      readr::write_csv(diag_df, file.path(root, "tau_threshold_diagnostics.csv"))
      readr::write_csv(run_log_df, file.path(root, "tau_run_log.csv"))
    }
  }
  msg("Wrote tau_threshold_diagnostics.csv and tau_run_log.csv to both roots.")

  cat("\n--- Genes passing each tau cutoff, by dataset ---\n")
  print(diag_df %>%
          select(dataset, n_clusters, threshold, n_genes_pass) %>%
          tidyr::pivot_wider(names_from = threshold, values_from = n_genes_pass))
}

hdr("TAU COMPLETE — %d/%d cohorts succeeded",
    sum(run_log_df$status == "ok"), nrow(run_log_df))
