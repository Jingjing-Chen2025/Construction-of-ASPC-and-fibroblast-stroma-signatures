# -----------------------------
# MAIN LOOP (NO SEURAT CLUSTERING)
# -----------------------------
all_tau <- list()

for (ds in datasets) {
  dataset_name <- ds$name
  cohort <- ds$cohort
  msg("Processing: %s (cohort=%s)", dataset_name, cohort)

  if (ds$type == "dense_csv_gz") {
    dense <- read_dense_csv_gz_with_cluster(ds$path, dataset_name = dataset_name)
    msg("Loaded dense (gene x cell): genes=%d cells=%d; clusters=%d",
        nrow(dense$counts), ncol(dense$counts), length(unique(dense$clusters)))

    res <- calc_tau_from_counts_and_clusters_mat(dense$counts, dense$clusters, dataset_name = dataset_name)
    tau_tbl <- res$tau_tbl %>% mutate(cohort = cohort)
    all_tau[[dataset_name]] <- tau_tbl

    out_tau <- file.path(cfg$out_dir, paste0(dataset_name, "_tau.csv"))
    readr::write_csv(tau_tbl, out_tau)
    saveRDS(res$pseudobulk, file.path(cfg$out_dir, paste0(dataset_name, "_pseudobulk.rds")))
    msg("Wrote: %s", out_tau)
    next
  }

  # load counts
  counts <- NULL
  if (ds$type == "pooled_10x_folders") {
    counts <- read_and_pool_10x_folders(ds$folders, dataset_name = dataset_name)
  } else if (ds$type == "pooled_10x_triplet") {
    counts <- read_and_pool_10x_triplets(ds$triplets, dataset_name = dataset_name)
  } else if (ds$type == "10x_folder") {
    counts <- read_10x_folder(ds$path)
  } else if (ds$type == "10x_triplet") {
    counts <- read_10x_triplet_files(ds$barcodes, ds$features, ds$matrix)
  } else if (ds$type == "gene_cell_exprs_table") {
    counts <- read_gene_cell_exprs_table(ds$path)
  } else if (ds$type == "10x_tar") {
    counts <- read_10x_tarball(ds$path)
  } else if (ds$type == "10x_zip") {
    counts <- read_10x_zip(ds$path)
  } else {
    warn_msg("Unknown ds$type: %s", ds$type)
    next
  }

  msg("Loaded counts: genes=%d cells=%d", nrow(counts), ncol(counts))

  clust <- cluster_counts_pca_kmeans(counts, dataset_name = dataset_name)
  msg("Clustered %s: n_clusters=%d", dataset_name, length(unique(clust$clusters)))

  res <- calc_tau_from_counts_and_clusters_mat(clust$counts, clust$clusters, dataset_name = dataset_name)
  tau_tbl <- res$tau_tbl %>% mutate(cohort = cohort)
  all_tau[[dataset_name]] <- tau_tbl

  out_tau <- file.path(cfg$out_dir, paste0(dataset_name, "_tau.csv"))
  readr::write_csv(tau_tbl, out_tau)
  saveRDS(res$pseudobulk, file.path(cfg$out_dir, paste0(dataset_name, "_pseudobulk.rds")))
  msg("Wrote: %s", out_tau)
}
