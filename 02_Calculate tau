cfg <- list(
  out_dir = "tau_results",

  # QC thresholds
  min_cells = 3,
  min_features = 200,

  # non-Seurat clustering params
  hvgs = 2000,
  n_pcs = 30,
  n_clusters = 8,     # kmeans K; adjust as desired
  kmeans_nstart = 10,

  # outputs requested
  marker_top_n = 100
)

