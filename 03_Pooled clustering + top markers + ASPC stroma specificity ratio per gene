# -----------------------------
# MAIN
# -----------------------------
for (grp in groups) {
  group_name <- grp$name
  target_cluster <- as.character(grp$target_cluster)
  target_label <- grp$target_label

  msg("=== GROUP: %s (target %s cluster=%s) ===", group_name, target_label, target_cluster)

  mats <- list()

  for (s in grp$samples) {
    msg("Loading sample: %s (type=%s)", s$sample_id, s$type)

    mat <- tryCatch({
      if (s$type == "10x_folder") {
        if (!dir.exists(s$path)) stop("Missing folder: ", s$path)
        read_10x_folder(s$path)
      } else if (s$type == "10x_triplet") {
        if (!file.exists(s$barcodes) || !file.exists(s$features) || !file.exists(s$matrix)) {
          stop("Missing triplet files for sample: ", s$sample_id)
        }
        read_10x_triplet_files(s$barcodes, s$features, s$matrix)
      } else if (s$type == "dense_csv_gz") {
        if (!file.exists(s$path)) stop("Missing file: ", s$path)
        read_dense_csv_gz_counts(s$path)
      } else if (s$type == "gene_cell_exprs_table") {
        if (!file.exists(s$path)) stop("Missing file: ", s$path)
        read_gene_cell_exprs_table(s$path)
      } else if (s$type == "10x_tar") {
        if (!file.exists(s$path)) stop("Missing tar.gz: ", s$path)
        read_10x_tarball(s$path)
      } else if (s$type == "10x_zip") {
        if (!file.exists(s$path)) stop("Missing zip: ", s$path)
        read_10x_zip(s$path)
      } else {
        stop("Unknown sample type: ", s$type)
      }
    }, error = function(e) {
      warn_msg("%s", e$message)
      NULL
    })

    if (is.null(mat)) next
    mat <- prefix_cell_barcodes(mat, s$sample_id)
    mats[[s$sample_id]] <- mat
    msg("Loaded %s: genes=%d cells=%d", s$sample_id, nrow(mat), ncol(mat))
  }

  if (length(mats) == 0) {
    warn_msg("No samples loaded for group: %s; skipping.", group_name)
    next
  }

  pooled_counts <- merge_by_union_genes(mats)
  msg("Pooled matrix: genes=%d cells=%d", nrow(pooled_counts), ncol(pooled_counts))

  # Seurat preprocess + choose resolution to get ~8 clusters
  so0 <- run_seurat_preprocess(pooled_counts, project_name = group_name)
  best <- find_resolution_for_k(so0, cfg$target_k, cfg$resolution_grid)
  so <- best$so
  msg("Chosen resolution=%.2f -> clusters=%d (target=%d)", best$resolution, best$k, cfg$target_k)

  so$sample_id <- sub("__.*$", "", Cells(so))

  # Cluster counts
  cc <- sort(table(so$seurat_clusters), decreasing = TRUE)
  cc_path <- file.path(cfg$out_dir, paste0(group_name, "_cluster_counts.csv"))
  write_csv(tibble(cluster = names(cc), n_cells = as.integer(cc)), cc_path)
  msg("Wrote: %s", cc_path)

  # Markers top 100 per cluster
  mk_top <- top_markers_per_cluster(so, group_name)
  out_mk <- file.path(cfg$out_dir, paste0(group_name, "_cluster_markers_top", cfg$top_n_markers, ".csv"))
  write_csv(mk_top, out_mk)
  msg("Wrote: %s", out_mk)

  # Compute gene-level aspc_specific_ratio using specified target cluster
  if (!(target_cluster %in% levels(so$seurat_clusters) || target_cluster %in% unique(as.character(so$seurat_clusters)))) {
    warn_msg("Target cluster %s not present in clustering results for %s. Ratio will be NA.", target_cluster, group_name)
  }

  pb <- pseudobulk_by_cluster(so)  # gene x cluster
  ratio <- calc_aspc_specific_ratio(pb, target_cluster)
  tau <- calc_tau(pb)

  ratio_tbl <- tibble(
    gene = toupper(rownames(pb)),
    aspc_specific_ratio = as.numeric(ratio),
    tau = as.numeric(tau),
    group = group_name,
    target_label = target_label,
    target_cluster = target_cluster,
    chosen_resolution = best$resolution,
    n_clusters = best$k
  )

  out_ratio <- file.path(cfg$out_dir, paste0(group_name, "_aspc_specific_ratio.csv"))
  write_csv(ratio_tbl, out_ratio)
  msg("Wrote: %s", out_ratio)

  # Optional save Seurat object
  if (isTRUE(cfg$write_seurat_rds)) {
    out_rds <- file.path(cfg$out_dir, paste0(group_name, "_seurat.rds"))
    saveRDS(so, out_rds)
    msg("Wrote: %s", out_rds)
  }
}

msg("DONE.")
