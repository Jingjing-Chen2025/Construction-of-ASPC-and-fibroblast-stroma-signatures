# -----------------------------
# Helpers
# -----------------------------
sanitize_gene_names <- function(x) {
  x <- as.character(x)
  x <- str_trim(x)
  x <- gsub("\uFEFF", "", x, fixed = TRUE)
  x <- gsub("\r", "", x, fixed = TRUE)
  x <- gsub("_", "-", x, fixed = FALSE)
  x[x == "" | is.na(x)] <- "NA_FEATURE"
  x
}
sanitize_cell_names <- function(x) {
  x <- as.character(x)
  x <- str_trim(x)
  x <- gsub("\uFEFF", "", x, fixed = TRUE)
  x <- gsub("\r", "", x, fixed = TRUE)
  x[x == "" | is.na(x)] <- "NA_CELL"
  x
}
collapse_duplicate_features <- function(mat) {
  rn <- rownames(mat)
  if (is.null(rn) || !any(duplicated(rn))) return(mat)
  f <- factor(rn, levels = unique(rn))
  G <- Matrix::sparse.model.matrix(~ 0 + f)
  agg <- Matrix::t(G) %*% mat
  rownames(agg) <- levels(f)
  agg
}
prefix_cell_barcodes <- function(mat, sample_id) {
  colnames(mat) <- paste0(sample_id, "__", colnames(mat))
  mat
}
merge_by_union_genes <- function(mats) {
  all_genes <- sort(unique(unlist(lapply(mats, rownames))))
  mats2 <- lapply(mats, function(m) {
    missing <- setdiff(all_genes, rownames(m))
    if (length(missing)) {
      z <- Matrix::Matrix(0, nrow = length(missing), ncol = ncol(m), sparse = TRUE)
      rownames(z) <- missing
      colnames(z) <- colnames(m)
      m <- rbind(m, z)
    }
    m[all_genes, , drop = FALSE]
  })
  pooled <- do.call(cbind, mats2)
  as(pooled, "dgCMatrix")
}

# -----------------------------
# Loaders
# -----------------------------
read_10x_folder <- function(folder) {
  mat <- Seurat::Read10X(data.dir = folder)
  if (is.list(mat)) {
    if ("Gene Expression" %in% names(mat)) mat <- mat[["Gene Expression"]] else mat <- mat[[1]]
  }
  mat <- as(mat, "dgCMatrix")
  rownames(mat) <- make.unique(sanitize_gene_names(rownames(mat)))
  colnames(mat) <- make.unique(sanitize_cell_names(colnames(mat)))
  collapse_duplicate_features(mat)
}
read_10x_triplet_files <- function(barcodes, features, matrix_mtx) {
  bc <- readLines(gzfile(barcodes))
  feat_dt <- data.table::fread(features, header = FALSE)
  genes <- if (ncol(feat_dt) >= 2) feat_dt[[2]] else feat_dt[[1]]
  genes <- make.unique(sanitize_gene_names(genes))

  m <- Matrix::readMM(gzfile(matrix_mtx))
  m <- as(m, "dgCMatrix")
  rownames(m) <- genes
  colnames(m) <- make.unique(sanitize_cell_names(bc))
  collapse_duplicate_features(m)
}
read_dense_csv_gz_counts <- function(path) {
  dt <- data.table::fread(cmd = paste("gzip -cd", shQuote(path)), data.table = FALSE)
  if (!("V1" %in% colnames(dt))) colnames(dt)[1] <- "V1"
  if (!("CLUSTER" %in% colnames(dt))) stop("Expected CLUSTER column not found: ", path)

  cell_id <- make.unique(sanitize_cell_names(dt[["V1"]]))

  gene_df <- dt[, setdiff(colnames(dt), c("V1", "CLUSTER")), drop = FALSE]
  mat_cell_by_gene <- as.matrix(gene_df)
  suppressWarnings(storage.mode(mat_cell_by_gene) <- "numeric")
  mat_cell_by_gene[is.na(mat_cell_by_gene)] <- 0

  genes <- sanitize_gene_names(colnames(mat_cell_by_gene))
  colnames(mat_cell_by_gene) <- genes

  counts <- t(mat_cell_by_gene) # gene x cell
  rownames(counts) <- make.unique(sanitize_gene_names(rownames(counts)))
  colnames(counts) <- cell_id
  counts <- as(counts, "dgCMatrix")
  collapse_duplicate_features(counts)
}
read_gene_cell_exprs_table <- function(path) {
  dt <- data.table::fread(cmd = paste("gzip -cd", shQuote(path)), data.table = FALSE)
  nms <- colnames(dt)
  if (!all(c("Gene_ID", "Symbol") %in% nms)) {
    stop("Unrecognized gene_cell_exprs_table format: ", path, "\nColumns: ", paste(nms, collapse = ", "))
  }

  genes <- toupper(sanitize_gene_names(dt[["Symbol"]]))
  genes[is.na(genes) | genes == ""] <- "NA_GENE"
  genes <- make.unique(genes)

  expr_df <- dt[, setdiff(nms, c("Gene_ID", "Symbol")), drop = FALSE]
  expr_mat <- as.matrix(expr_df)
  suppressWarnings(storage.mode(expr_mat) <- "numeric")
  expr_mat[is.na(expr_mat)] <- 0

  rownames(expr_mat) <- genes
  colnames(expr_mat) <- make.unique(sanitize_cell_names(colnames(expr_mat)))

  mat <- as(expr_mat, "dgCMatrix")
  collapse_duplicate_features(mat)
}
read_10x_tarball <- function(tar_gz_path, tmp_base = tempdir()) {
  outdir <- file.path(tmp_base, paste0("untar_", tools::file_path_sans_ext(basename(tar_gz_path)), "_", as.integer(Sys.time())))
  dir.create(outdir, recursive = TRUE, showWarnings = FALSE)
  utils::untar(tar_gz_path, exdir = outdir)
  mtx <- list.files(outdir, pattern = "matrix\\.mtx(\\.gz)?$", recursive = TRUE, full.names = TRUE)
  if (!length(mtx)) stop("No matrix.mtx found after untar: ", tar_gz_path)
  read_10x_folder(dirname(mtx[1]))
}
read_10x_zip <- function(zip_path, tmp_base = tempdir()) {
  outdir <- file.path(tmp_base, paste0("unzip_", tools::file_path_sans_ext(basename(zip_path)), "_", as.integer(Sys.time())))
  dir.create(outdir, recursive = TRUE, showWarnings = FALSE)
  utils::unzip(zip_path, exdir = outdir)
  mtx <- list.files(outdir, pattern = "matrix\\.mtx(\\.gz)?$", recursive = TRUE, full.names = TRUE)
  if (!length(mtx)) stop("No matrix.mtx found after unzip: ", zip_path)
  read_10x_folder(dirname(mtx[1]))
}

# -----------------------------
# Seurat clustering (target ~8 clusters)
# -----------------------------
run_seurat_preprocess <- function(counts, project_name) {
  so <- CreateSeuratObject(
    counts = counts,
    project = project_name,
    min.cells = cfg$min_cells,
    min.features = cfg$min_features
  )
  so <- NormalizeData(so)
  so <- FindVariableFeatures(so, selection.method = "mvp", nfeatures = cfg$nfeatures)
  so <- ScaleData(so)
  so <- RunPCA(so)
  so <- FindNeighbors(so, dims = cfg$dims)
  so
}
find_resolution_for_k <- function(so, target_k, grid) {
  best <- list(resolution = NA_real_, k = Inf, so = NULL, diff = Inf)
  for (r in grid) {
    so_r <- FindClusters(so, resolution = r, verbose = FALSE)
    k <- length(unique(so_r$seurat_clusters))
    d <- abs(k - target_k)
    if (d < best$diff) {
      best <- list(resolution = r, k = k, so = so_r, diff = d)
      if (d == 0) break
    }
  }
  best
}

# -----------------------------
# Markers
# -----------------------------
top_markers_per_cluster <- function(so, group_name) {
  Idents(so) <- so$seurat_clusters
  mk <- FindAllMarkers(
    object = so,
    only.pos = cfg$only_pos,
    test.use = cfg$test_use,
    min.pct = cfg$min_pct,
    logfc.threshold = cfg$logfc_threshold
  )
  if ("avg_logFC" %in% colnames(mk) && !("avg_log2FC" %in% colnames(mk))) {
    mk <- mk %>% rename(avg_log2FC = avg_logFC)
  }
  mk %>%
    mutate(group = group_name) %>%
    group_by(cluster) %>%
    arrange(desc(avg_log2FC), .by_group = TRUE) %>%
    slice_head(n = cfg$top_n_markers) %>%
    ungroup()
}

# -----------------------------
# ASPC specificity ratio on pooled clusters
# -----------------------------
calc_tau <- function(pb_mat) {
  apply(pb_mat, 1, function(x) {
    if (all(is.na(x))) return(NA_real_)
    mx <- max(x, na.rm = TRUE)
    if (!is.finite(mx) || mx <= 0) return(0)
    sum(1 - (x / mx), na.rm = TRUE) / (length(x) - 1)
  })
}

calc_aspc_specific_ratio <- function(pb_mat, target_cluster) {
  # pb_mat: gene x cluster matrix
  lev <- colnames(pb_mat)
  idx <- which(as.character(lev) == as.character(target_cluster))
  if (length(idx) != 1) return(rep(NA_real_, nrow(pb_mat)))

  target_expr <- pb_mat[, idx]
  other_idx <- setdiff(seq_along(lev), idx)
  other_expr <- if (length(other_idx) == 0) rep(0, length(target_expr)) else apply(pb_mat[, other_idx, drop = FALSE], 1, max, na.rm = TRUE)

  ifelse(other_expr > 0, target_expr / other_expr, Inf)
}

pseudobulk_by_cluster <- function(so) {
  # Use log-normalized data for marker-like ratios
  mat <- GetAssayData(so, layer = "data")
  cl <- as.character(so$seurat_clusters)
  names(cl) <- colnames(mat)

  lev <- sort(unique(cl))
  pb <- sapply(lev, function(k) {
    cells <- names(cl)[cl == k]
    if (length(cells) == 1) return(as.numeric(mat[, cells, drop = FALSE]))
    Matrix::rowMeans(mat[, cells, drop = FALSE])
  })
  rownames(pb) <- rownames(mat)
  colnames(pb) <- lev
  pb
}

