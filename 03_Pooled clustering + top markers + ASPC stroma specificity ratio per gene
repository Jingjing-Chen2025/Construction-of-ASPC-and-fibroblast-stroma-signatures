# Yanai tau across clusters (same definition as 02_)
calc_tau <- function(pb_mat) {
  apply(pb_mat, 1, function(x) {
    mx <- max(x, na.rm = TRUE)
    if (!is.finite(mx) || mx <= 0) return(0)
    sum(1 - (x / mx), na.rm = TRUE) / (length(x) - 1)
  })
}

# ratio = target cluster mean / max mean across all other clusters
calc_target_ratio <- function(pb_mat, target_cluster) {
  lev <- as.character(colnames(pb_mat))
  idx <- which(lev == as.character(target_cluster))
  if (length(idx) != 1) {
    warn_msg("  Target cluster '%s' not among clusters (%s). Ratio = NA.",
             target_cluster, paste(lev, collapse = ", "))
    return(rep(NA_real_, nrow(pb_mat)))
  }

  tgt   <- pb_mat[, idx]
  other <- pb_mat[, -idx, drop = FALSE]
  omax  <- if (ncol(other) == 0) rep(0, length(tgt)) else
    apply(other, 1, max, na.rm = TRUE)

  ifelse(omax > 0, tgt / omax,
         ifelse(tgt > 0, cfg$ratio_inf_value, 0))
}

# Rebuild pseudobulk from seurat_merged.rds when 02_ output is absent.
pseudobulk_from_seurat <- function(rds_path) {
  so <- readRDS(rds_path)
  if (inherits(so[["RNA"]], "Assay5")) so <- JoinLayers(so)
  mat <- GetAssayData(so, assay = "RNA", layer = "data")
  cl  <- as.character(so$seurat_clusters)
  names(cl) <- colnames(so)

  lev <- sort(unique(cl))
  pb <- sapply(lev, function(k) {
    cells <- names(cl)[cl == k]
    Matrix::rowMeans(mat[, cells, drop = FALSE])
  })
  rownames(pb) <- rownames(mat)
  colnames(pb) <- lev
  rm(so, mat); gc(verbose = FALSE)
  pb
}

# Load the pseudobulk matrix, preferring 02_'s saved object.
get_pseudobulk <- function(co) {
  pb_path <- file.path(co$dir, paste0(co$name, "_pseudobulk.rds"))
  if (file.exists(pb_path)) {
    msg("  Using pseudobulk from 02_: %s", basename(pb_path))
    return(readRDS(pb_path))
  }
  seu_path <- file.path(co$dir, "seurat_merged.rds")
  if (!file.exists(seu_path)) {
    stop("Neither ", basename(pb_path), " nor seurat_merged.rds found in ", co$dir)
  }
  warn_msg("  02_ pseudobulk absent; rebuilding from seurat_merged.rds")
  pseudobulk_from_seurat(seu_path)
}

# Read the batch pipeline's marker table and extract the target cluster.
get_target_markers <- function(co) {
  mk_path <- file.path(co$dir, cfg$marker_file)
  if (!file.exists(mk_path)) {
    stop("Marker file not found: ", mk_path,
         " — run scRNA_batch_pipeline.R for this cohort first")
  }

  mk <- readr::read_csv(mk_path, show_col_types = FALSE)

  if (!"cluster" %in% colnames(mk)) stop("No 'cluster' column in ", mk_path)
  if (!"gene"    %in% colnames(mk)) stop("No 'gene' column in ",    mk_path)

  # Seurat v4 wrote avg_logFC; v5 writes avg_log2FC
  if ("avg_logFC" %in% colnames(mk) && !("avg_log2FC" %in% colnames(mk))) {
    mk <- dplyr::rename(mk, avg_log2FC = avg_logFC)
  }

  present <- unique(as.character(mk$cluster))
  msg("  Marker file clusters: %s", paste(sort(present), collapse = ", "))

  tgt <- mk %>% filter(as.character(cluster) == as.character(co$target_cluster))
  if (!nrow(tgt)) {
    stop("Target cluster '", co$target_cluster, "' has no markers in ",
         basename(mk_path), ". Clusters present: ", paste(sort(present), collapse = ", "))
  }

  p_col <- if ("p_val_adj" %in% colnames(tgt)) "p_val_adj" else "p_val"
  tgt <- tgt %>% filter(.data[[p_col]] < cfg$p_cutoff)

  ord <- if (cfg$rank_by == "avg_log2FC" && "avg_log2FC" %in% colnames(tgt)) {
    tgt %>% arrange(desc(avg_log2FC))
  } else {
    tgt %>% arrange(.data[[p_col]])
  }

  ord %>%
    slice_head(n = cfg$top_n_markers) %>%
    mutate(rank = row_number(),
           dataset = co$name,
           cohort_group = co$group,
           species = co$species,
           target_cluster = as.character(co$target_cluster),
           target_label = co$target_label)
}

# ============================================================================
# PER-COHORT PROCESSING
# ============================================================================
process_cohort_markers <- function(co) {
  hdr("MARKERS + RATIO: %s  (target %s = cluster %s)",
      co$name, co$target_label, co$target_cluster)

  if (!dir.exists(co$dir)) stop("Cohort directory not found: ", co$dir)
  if (file.access(co$dir, mode = 2) != 0) stop("Directory not writable: ", co$dir)

  # ---- top 200 markers of the target cluster ----
  mk_top <- get_target_markers(co)
  out_mk <- file.path(co$dir, sprintf("%s_target_markers_top%d.csv",
                                      co$name, cfg$top_n_markers))
  readr::write_csv(mk_top, out_mk)
  msg("Wrote %d markers for cluster %s: %s",
      nrow(mk_top), co$target_cluster, basename(out_mk))

  # ---- gene-level ratio + tau on the same partition ----
  pb <- get_pseudobulk(co)
  msg("Pseudobulk: %d genes x %d clusters (%s)",
      nrow(pb), ncol(pb), paste(colnames(pb), collapse = ", "))

  ratio <- calc_target_ratio(pb, co$target_cluster)
  tau   <- calc_tau(pb)

  genes_out <- rownames(pb)
  if (isTRUE(cfg$uppercase_genes)) genes_out <- toupper(genes_out)

  ratio_tbl <- tibble(
    gene                = genes_out,
    aspc_specific_ratio = as.numeric(ratio),
    tau                 = as.numeric(tau),
    dataset             = co$name,
    cohort_group        = co$group,
    species             = co$species,
    target_cluster      = as.character(co$target_cluster),
    target_label        = co$target_label,
    n_clusters          = ncol(pb)
  ) %>%
    group_by(gene) %>%                    # collapse toupper() collisions
    summarise(aspc_specific_ratio = max(aspc_specific_ratio, na.rm = TRUE),
              tau = max(tau, na.rm = TRUE),
              dataset = first(dataset),
              cohort_group = first(cohort_group),
              species = first(species),
              target_cluster = first(target_cluster),
              target_label = first(target_label),
              n_clusters = first(n_clusters),
              .groups = "drop") %>%
    mutate(aspc_specific_ratio = ifelse(is.finite(aspc_specific_ratio),
                                        aspc_specific_ratio, NA_real_)) %>%
    arrange(desc(aspc_specific_ratio))

  out_ratio <- file.path(co$dir, paste0(co$name, "_aspc_specific_ratio.csv"))
  readr::write_csv(ratio_tbl, out_ratio)
  msg("Wrote: %s", basename(out_ratio))

  # ---- how many top markers are also ratio-high? sanity link ----
  mk_genes <- toupper(mk_top$gene)
  r_lookup <- setNames(ratio_tbl$aspc_specific_ratio, ratio_tbl$gene)
  mk_ratio <- r_lookup[mk_genes]
  n_gt2 <- sum(mk_ratio > 2, na.rm = TRUE)
  msg("Of the top %d markers, %d have ratio > 2 (median ratio %.2f)",
      nrow(mk_top), n_gt2, median(mk_ratio, na.rm = TRUE))

  # ---- diagnostic plot ----
  if (isTRUE(cfg$write_plots)) {
    pdat <- ratio_tbl %>% filter(is.finite(aspc_specific_ratio),
                                 aspc_specific_ratio > 0)
    if (nrow(pdat) > 10) {
      p <- ggplot(pdat, aes(x = log2(aspc_specific_ratio), y = tau)) +
        geom_point(alpha = 0.25, size = 0.6) +
        geom_vline(xintercept = 1, colour = "red", linetype = 2) +
        geom_hline(yintercept = 0.95, colour = "blue", linetype = 2) +
        labs(title = sprintf("%s — specificity of cluster %s (%s)",
                             co$name, co$target_cluster, co$target_label),
             subtitle = sprintf("%d clusters | red: ratio = 2 | blue: tau = 0.95",
                                ncol(pb)),
             x = "log2(target / max other)", y = "tau") +
        theme_minimal(base_size = 11)
      pdf(file.path(co$dir, paste0(co$name, "_ratio_vs_tau.pdf")),
          width = 7, height = 5)
      print(p); dev.off()
    }
  }

  rm(pb); gc(verbose = FALSE)

  list(
    markers = mk_top,
    ratio   = ratio_tbl,
    log = data.frame(
      cohort = co$name, dir = co$dir, group = co$group,
      target_cluster = as.character(co$target_cluster),
      target_label = co$target_label,
      status = "ok",
      n_markers = nrow(mk_top),
      n_genes = nrow(ratio_tbl),
      n_clusters = ratio_tbl$n_clusters[1],
      n_markers_ratio_gt2 = n_gt2,
      stringsAsFactors = FALSE)
  )
}

# ============================================================================
# MAIN LOOP
# ============================================================================
all_markers <- list()
all_ratios  <- list()
run_log     <- list()

for (co in cohorts) {
  t0 <- Sys.time()
  res <- tryCatch(process_cohort_markers(co), error = function(e) {
    warn_msg("COHORT FAILED [%s]: %s", co$name, conditionMessage(e))
    list(markers = NULL, ratio = NULL,
         log = data.frame(
           cohort = co$name, dir = co$dir, group = co$group,
           target_cluster = as.character(co$target_cluster),
           target_label = co$target_label,
           status = paste("failed:", conditionMessage(e)),
           n_markers = NA_integer_, n_genes = NA_integer_,
           n_clusters = NA_integer_, n_markers_ratio_gt2 = NA_integer_,
           stringsAsFactors = FALSE))
  })
  res$log$minutes <- round(as.numeric(difftime(Sys.time(), t0, units = "mins")), 2)
  run_log[[length(run_log) + 1]] <- res$log
  if (!is.null(res$markers)) all_markers[[co$name]] <- res$markers
  if (!is.null(res$ratio))   all_ratios[[co$name]]  <- res$ratio
  gc(verbose = FALSE)
}

run_log_df <- bind_rows(run_log)
print(run_log_df)

# ============================================================================
# POOLED RATIO TABLES — what 06_ reads
# ============================================================================
hdr("POOLING RATIO TABLES FOR 06_")

pool_ratios <- function(group_name, root) {
  tabs <- all_ratios[vapply(all_ratios,
    function(t) t$cohort_group[1] == group_name, logical(1))]
  if (!length(tabs)) {
    warn_msg("No successful cohorts for group %s; skipping pooled file.", group_name)
    return(NULL)
  }

  long <- bind_rows(tabs)

  pooled <- long %>%
    group_by(gene) %>%
    summarise(
      aspc_specific_ratio = median(aspc_specific_ratio, na.rm = TRUE),
      ratio_mean          = mean(aspc_specific_ratio, na.rm = TRUE),
      ratio_max           = suppressWarnings(max(aspc_specific_ratio, na.rm = TRUE)),
      ratio_min           = suppressWarnings(min(aspc_specific_ratio, na.rm = TRUE)),
      tau                 = median(tau, na.rm = TRUE),
      n_datasets          = n_distinct(dataset),
      n_datasets_ratio_gt2 = sum(aspc_specific_ratio > 2, na.rm = TRUE),
      .groups = "drop"
    ) %>%
    mutate(across(where(is.numeric), ~ ifelse(is.finite(.x), .x, NA_real_))) %>%
    arrange(desc(aspc_specific_ratio))

  out <- file.path(root, sprintf("ratio_%s_all_datasets.csv", group_name))
  readr::write_csv(pooled, out)
  msg("Wrote pooled %s ratios: %s  (%d genes from %d cohorts)",
      group_name, out, nrow(pooled), length(tabs))

  readr::write_csv(long, file.path(root,
    sprintf("ratio_%s_per_dataset_long.csv", group_name)))

  pooled
}

pooled_nepc_ratio  <- pool_ratios("NEPC",  NEPC_ROOT)
pooled_adeno_ratio <- pool_ratios("Adeno", ADENO_ROOT)

# ============================================================================
# POOLED MARKER LISTS
# ============================================================================
pool_markers <- function(group_name, root) {
  tabs <- all_markers[vapply(all_markers,
    function(t) t$cohort_group[1] == group_name, logical(1))]
  if (!length(tabs)) return(NULL)

  stacked <- bind_rows(tabs)
  out <- file.path(root, sprintf("target_markers_%s_pooled.csv", group_name))
  readr::write_csv(stacked, out)
  msg("Wrote pooled %s markers: %s (%d rows from %d cohorts)",
      group_name, out, nrow(stacked), length(tabs))

  # recurrence: how many cohorts list each gene in its top 200
  recur <- stacked %>%
    mutate(gene = toupper(gene)) %>%
    group_by(gene) %>%
    summarise(n_datasets = n_distinct(dataset),
              datasets = paste(sort(unique(dataset)), collapse = ";"),
              median_rank = median(rank),
              .groups = "drop") %>%
    arrange(desc(n_datasets), median_rank)

  readr::write_csv(recur, file.path(root,
    sprintf("target_markers_%s_recurrence.csv", group_name)))
  msg("  Genes in >= half of %s cohorts: %d",
      group_name, sum(recur$n_datasets >= ceiling(length(tabs) / 2)))

  recur
}

recur_nepc  <- pool_markers("NEPC",  NEPC_ROOT)
recur_adeno <- pool_markers("Adeno", ADENO_ROOT)

