    pdf(file.path(out_dir, "07_umap_celltypes.pdf"), width = 9, height = 6); print(p4); dev.off()
    pdf(file.path(out_dir, "07_umap_clusters_named_and_celltypes.pdf"), width = 14, height = 6); print(p1 + p4); dev.off()
